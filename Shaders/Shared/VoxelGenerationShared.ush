// Smoothstep at a voxel's offset 0..3 in its 4-voxel lattice cell, in 32nds: 3t^2 - 2t^3 at t = 0, 1/4, 1/2, 3/4.
#define VOXELGEN_BLEND_DITHER_FAR_WEIGHT { 0u, 5u, 16u, 27u }

// ==================== The Simplex kernel (FVoxelNoise, VoxelNoise.ush) ====================

// The twelve gradient vectors; V(x, y, z) is each side's vector constructor.
#define VOXELGEN_SIMPLEX_GRAD3(V) { \
	V(1,1,0), V(-1,1,0), V(1,-1,0), V(-1,-1,0), \
	V(1,0,1), V(-1,0,1), V(1,0,-1), V(-1,0,-1), \
	V(0,1,1), V(0,-1,1), V(0,1,-1), V(0,-1,-1) \
}

// The skew and unskew factors of the 3D simplex lattice.
#define VOXELGEN_SIMPLEX_SKEW_F3 (1.0f / 3.0f)
#define VOXELGEN_SIMPLEX_UNSKEW_G3 (1.0f / 6.0f)

// A corner's contribution. The classic kernel (0.6 - d^2)^4 reaches past the simplex and steps where the next one begins;
// the continuous kernel (G43) is that less its value and slope at d^2 = 0.5: v^2 (v^2 + 0.4 v + 0.06) with v = 0.5 - d^2.
// Unsuffixed: the C++ kernel casts them to its float or double T; HLSL reads them as float.
#define VOXELGEN_SIMPLEX_CLASSIC_RADIUS2 0.6
#define VOXELGEN_SIMPLEX_CONTINUOUS_RADIUS2 0.5
#define VOXELGEN_SIMPLEX_CONTINUOUS_B 0.4
#define VOXELGEN_SIMPLEX_CONTINUOUS_C 0.06

// The corner sum's scale: 32 for the classic kernel; 33.25 gives the continuous one the same spread.
#define VOXELGEN_SIMPLEX_SCALE_CLASSIC 32.0f
#define VOXELGEN_SIMPLEX_SCALE_CONTINUOUS 33.25f
