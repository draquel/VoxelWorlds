//
// What CPU and GPU generation share by value, defined once for both languages (code review CR2, CORE-22, on the engine's
// Shaders/Shared pattern): the enum integers, the voxel flag bits, the surface threshold, the GPU upload strides, the
// biome blend dither's seed offset and distribution table, and the Simplex kernel's gradient table and constants.
// C++ includes it as "VoxelGenerationShared.ush" (VoxelCore's public include path; the shader compiler accepts only .usf
// and .ush on a plugin's virtual path, so the shared file carries the shader extension and C++ includes that); HLSL as
// "/Plugin/VoxelWorlds/Shared/VoxelGenerationShared.ush". Only #defines and macro lists live here, so a value is written
// once; each side's enums, constants and tables are defined from them, with static_asserts on the C++ side where the
// C++ declaration is not derived (the UENUMs). The arithmetic that uses these stays a documented pair, kept equal by the
// GPUvsCPU parity tests. The hash mix the noise, the ore Rarity and the dither share is VoxelHash.h / VoxelHash.ush.

#pragma once

// ==================== Enum integers ====================

// EWorldMode (VoxelCoreTypes.h)
#define VOXELGEN_WORLD_MODE_INFINITE_PLANE 0
#define VOXELGEN_WORLD_MODE_SPHERICAL_PLANET 1
#define VOXELGEN_WORLD_MODE_ISLAND_BOWL 2

// EVoxelNoiseType (VoxelCoreTypes.h)
#define VOXELGEN_NOISE_TYPE_PERLIN 0
#define VOXELGEN_NOISE_TYPE_SIMPLEX 1
#define VOXELGEN_NOISE_TYPE_CELLULAR 2
#define VOXELGEN_NOISE_TYPE_VORONOI 3

// ECaveType (VoxelCaveTypes.h)
#define VOXELGEN_CAVE_TYPE_CHEESE 0
#define VOXELGEN_CAVE_TYPE_SPAGHETTI 1
#define VOXELGEN_CAVE_TYPE_NOODLE 2

// ==================== The voxel word ====================

// FVoxelData::Pack: [Metadata:8][BiomeID:8][Density:8][MaterialID:8]; the flags in the metadata byte's high nibble.
#define VOXELGEN_FLAG_WATER 0x01u
#define VOXELGEN_FLAG_CAVE 0x02u
#define VOXELGEN_FLAG_UNDERGROUND 0x04u

// FVoxelData::IsSolid: the density byte at or above this is solid.
#define VOXELGEN_SURFACE_THRESHOLD 127u

// ==================== GPU upload layouts ====================

// UVoxelBiomeConfiguration::BuildGpuData: float4s per record in BiomeData, HeightRuleData and OreVeinData.
#define VOXELGEN_BIOME_FLOAT4_STRIDE 5
#define VOXELGEN_HEIGHTRULE_FLOAT4_STRIDE 2
#define VOXELGEN_OREVEIN_FLOAT4_STRIDE 3

// The most cave layers the density shader takes (one int4 / float4 per layer parameter).
#define VOXELGEN_MAX_GPU_CAVE_LAYERS 4

// ==================== The biome blend dither (FVoxelBiomeBlendDither, GpuBiomeBlendDither) ====================

// Added to the world seed, so the dither is not correlated with other hashes of it.
#define VOXELGEN_BLEND_DITHER_SEED_OFFSET 0x5D1A3

// The raw value noise's CDF, from a Monte Carlo over the 64 offsets in a cell with independent uniform corner hashes (256M
// samples; WORLD_MODES_REVIEW_PLAN.md, G39): Cdf[b] = P(raw < b * 2^23), in 2^-24 units. The largest step is 135,388, so
// Equalise's product stays in 32 bits. A test checks the equalised value is uniform (Biome.BlendDither.Uniform).
#define VOXELGEN_BLEND_DITHER_CDF { \
	0u, 1144u, 2511u, 4118u, 5976u, 8053u, 10436u, 13114u, \
	16089u, 19368u, 23007u, 27023u, 31443u, 36279u, 41571u, 47347u, \
	53617u, 60473u, 67882u, 75875u, 84542u, 93894u, 103961u, 114815u, \
	126514u, 139018u, 152469u, 166812u, 182232u, 198664u, 216171u, 234854u, \
	254725u, 275898u, 298251u, 321907u, 347027u, 373598u, 401710u, 431300u, \
	462397u, 494995u, 528885u, 564200u, 601035u, 639251u, 678931u, 719987u, \
	762433u, 806435u, 851908u, 899044u, 947496u, 997525u, 1048975u, 1101898u, \
	1156321u, 1212255u, 1269510u, 1328282u, 1388433u, 1449970u, 1512889u, 1577391u, \
	1643288u, 1710351u, 1778680u, 1848404u, 1919407u, 1991743u, 2065398u, 2140147u, \
	2216198u, 2293512u, 2372187u, 2451933u, 2533020u, 2615237u, 2699020u, 2783856u, \
	2869817u, 2957084u, 3045531u, 3135443u, 3226522u, 3318677u, 3412338u, 3507187u, \
	3603298u, 3700634u, 3799246u, 3899080u, 4000105u, 4102324u, 4205902u, 4310827u, \
	4416751u, 4524055u, 4632642u, 4742375u, 4853333u, 4965650u, 5079087u, 5193667u, \
