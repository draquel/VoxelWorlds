//
// The terrain noise on the GPU (spherical Phase 6, WM-BP5, D22, WORLD_MODES_REVIEW_PLAN.md §20.1; every world mode since
// the world modes review's MP4, D39): the twin of FVoxelNoise (VoxelNoise.cpp), the same float operations in
// the same order. A hashed integer lattice with no period and split-origin sampling: each field's origin is split per
// octave on the CPU, in double, into an integer lattice cell and a float fraction (NoiseOrigins, 2 float4s a split:
// [asfloat(cell), 0][frac, 0]), and the shader adds the voxel's small offset in noise units, so every float here is of
// the size of a lattice cell, at any radius or distance from the origin. Both branches of GenerateVoxelDensity.usf
// sample through NoiseFBM3D (the classic table noise shaders were deleted in CR1, CORE-03; the file and its functions
// carried planet names until CR3, CORE-28).
//
// Include AFTER the generation globals (GenerateVoxelDensity.usf): reads NoiseOrigins and SimplexContinuous.

#pragma once

// The lattice hash is VoxelLatticeHash (VoxelHash.ush, the one mix generation shares); the Simplex kernel's table and
// constants are VOXELGEN_SIMPLEX_* (VoxelGenerationShared.ush), the same values the CPU's FVoxelNoise reads.
#include "/Plugin/VoxelWorlds/Shared/VoxelHash.ush"
#include "/Plugin/VoxelWorlds/Shared/VoxelGenerationShared.ush"

static const int3 NoiseGrad3[12] = VOXELGEN_SIMPLEX_GRAD3(int3);

// A simplex corner's contribution (FVoxelNoise's SimplexCorner). G43: the continuous kernel, (0.6 - d^2)^4 less its
// value and slope at d^2 = 0.5, v^2 (v^2 + 0.4 v + 0.06) with v = 0.5 - d^2, reaches zero where the next simplex begins;
// SimplexContinuous 0 (voxel.Planet.ContinuousSimplex) keeps the classic one, which steps there.
float NoiseSimplexCorner(uint Hash, float3 X)
{
    const int3 G = NoiseGrad3[Hash % 12u];
    if (SimplexContinuous != 0)
    {
        const float V = VOXELGEN_SIMPLEX_CONTINUOUS_RADIUS2 - X.x * X.x - X.y * X.y - X.z * X.z;
        if (V <= 0.0f)
        {
            return 0.0f;
        }
        const float W = V * V * ((V + VOXELGEN_SIMPLEX_CONTINUOUS_B) * V + VOXELGEN_SIMPLEX_CONTINUOUS_C);
        return W * ((float)G.x * X.x + (float)G.y * X.y + (float)G.z * X.z);
    }
    float R = VOXELGEN_SIMPLEX_CLASSIC_RADIUS2 - X.x * X.x - X.y * X.y - X.z * X.z;
    if (R < 0.0f)
    {
        return 0.0f;
    }
    R *= R;
    return R * R * ((float)G.x * X.x + (float)G.y * X.y + (float)G.z * X.z);
}

// FVoxelNoise::Simplex: Simplex noise at the split origin (Cell, Frac in the skewed lattice) + Offset (noise units).
float NoiseSimplex(uint3 Cell, float3 Frac, float3 Offset, int Seed)
{
    const float F3P = VOXELGEN_SIMPLEX_SKEW_F3;
    const float G3P = VOXELGEN_SIMPLEX_UNSKEW_G3;

    const float S = (Offset.x + Offset.y + Offset.z) * F3P;
    const float3 G = float3(Frac.x + (Offset.x + S), Frac.y + (Offset.y + S), Frac.z + (Offset.z + S));
    const int3 C = (int3)floor(G);
    const float3 F = G - (float3)C;

    const float T = (F.x + F.y + F.z) * G3P;
    const float3 X0 = F - T;

    int3 I1, I2;
    if (X0.x >= X0.y)
    {
        if (X0.y >= X0.z) { I1 = int3(1, 0, 0); I2 = int3(1, 1, 0); }
        else if (X0.x >= X0.z) { I1 = int3(1, 0, 0); I2 = int3(1, 0, 1); }
        else { I1 = int3(0, 0, 1); I2 = int3(1, 0, 1); }
    }
    else
    {
        if (X0.y < X0.z) { I1 = int3(0, 0, 1); I2 = int3(0, 1, 1); }
        else if (X0.x < X0.z) { I1 = int3(0, 1, 0); I2 = int3(0, 1, 1); }
        else { I1 = int3(0, 1, 0); I2 = int3(1, 1, 0); }
    }

    const float3 X1 = X0 - (float3)I1 + G3P;
    const float3 X2 = X0 - (float3)I2 + 2.0f * G3P;
    const float3 X3 = X0 - 1.0f + 3.0f * G3P;

    const uint3 B = Cell + asuint(C);
    const float N0 = NoiseSimplexCorner(VoxelLatticeHash(B, Seed), X0);
    const float N1 = NoiseSimplexCorner(VoxelLatticeHash(B + asuint(I1), Seed), X1);
    const float N2 = NoiseSimplexCorner(VoxelLatticeHash(B + asuint(I2), Seed), X2);
    const float N3 = NoiseSimplexCorner(VoxelLatticeHash(B + uint3(1u, 1u, 1u), Seed), X3);
    // The sum's scale: 33.25 gives the continuous kernel the classic one's spread (32).
    return (SimplexContinuous != 0 ? VOXELGEN_SIMPLEX_SCALE_CONTINUOUS : VOXELGEN_SIMPLEX_SCALE_CLASSIC) * (N0 + N1 + N2 + N3);
}

float NoiseGrad(uint Hash, float X, float Y, float Z)
{
    const uint H = Hash & 15u;
    const float U = H < 8u ? X : Y;
    const float V = H < 4u ? Y : ((H == 12u || H == 14u) ? X : Z);
    return ((H & 1u) == 0u ? U : -U) + ((H & 2u) == 0u ? V : -V);
}

float NoiseFade(float X)
{
    return X * X * X * (X * (X * 6.0f - 15.0f) + 10.0f);
}

float NoiseLerp(float A, float B, float Alpha)
{
    return A + Alpha * (B - A);
}

// FVoxelNoise::Perlin: improved gradient noise at the split origin (cube lattice) + Offset.
float NoisePerlin(uint3 Cell, float3 Frac, float3 Offset, int Seed)
{
    const float3 G = Frac + Offset;
    const int3 C = (int3)floor(G);
    const float X = G.x - (float)C.x;
    const float Y = G.y - (float)C.y;
    const float Z = G.z - (float)C.z;
    const uint3 B = Cell + asuint(C);
    const float U = NoiseFade(X);
    const float V = NoiseFade(Y);
    const float W = NoiseFade(Z);
    return NoiseLerp(
        NoiseLerp(
            NoiseLerp(NoiseGrad(VoxelLatticeHash(B, Seed), X, Y, Z), NoiseGrad(VoxelLatticeHash(B + uint3(1u, 0u, 0u), Seed), X - 1.0f, Y, Z), U),
            NoiseLerp(NoiseGrad(VoxelLatticeHash(B + uint3(0u, 1u, 0u), Seed), X, Y - 1.0f, Z), NoiseGrad(VoxelLatticeHash(B + uint3(1u, 1u, 0u), Seed), X - 1.0f, Y - 1.0f, Z), U), V),
        NoiseLerp(
            NoiseLerp(NoiseGrad(VoxelLatticeHash(B + uint3(0u, 0u, 1u), Seed), X, Y, Z - 1.0f), NoiseGrad(VoxelLatticeHash(B + uint3(1u, 0u, 1u), Seed), X - 1.0f, Y, Z - 1.0f), U),
            NoiseLerp(NoiseGrad(VoxelLatticeHash(B + uint3(0u, 1u, 1u), Seed), X, Y - 1.0f, Z - 1.0f), NoiseGrad(VoxelLatticeHash(B + uint3(1u, 1u, 1u), Seed), X - 1.0f, Y - 1.0f, Z - 1.0f), U), V), W);
}

// FVoxelNoise::Cellular: (F1, F2) over the 3x3x3 cells around the split origin + Offset.
float2 NoiseCellular(uint3 Cell, float3 Frac, float3 Offset, int Seed)
{
    const float3 G = Frac + Offset;
    const int3 C = (int3)floor(G);
    const float3 F = G - (float3)C;
    const uint3 B = Cell + asuint(C);
    float F1 = 100.0f;
    float F2 = 100.0f;
    // [loop]s: FXC unrolls these otherwise, once per noise call site (F2.13, as Cellular3D).
    [loop]
    for (int DZ = -1; DZ <= 1; ++DZ)
    {
        [loop]
        for (int DY = -1; DY <= 1; ++DY)
        {
            [loop]
            for (int DX = -1; DX <= 1; ++DX)
            {
                const uint3 N = B + asuint(int3(DX, DY, DZ));
                const float DeltaX = (float)DX + VoxelHashUnit(VoxelLatticeHash(N, Seed)) - F.x;
                const float DeltaY = (float)DY + VoxelHashUnit(VoxelLatticeHash(N, Seed + 1)) - F.y;
                const float DeltaZ = (float)DZ + VoxelHashUnit(VoxelLatticeHash(N, Seed + 2)) - F.z;
                const float DistSq = DeltaX * DeltaX + DeltaY * DeltaY + DeltaZ * DeltaZ;
                if (DistSq < F1)
                {
                    F2 = F1;
                    F1 = DistSq;
                }
                else if (DistSq < F2)
                {
                    F2 = DistSq;
                }
            }
        }
    }
    return float2(sqrt(F1), sqrt(F2));
}

// FVoxelNoise::Sample: one octave of the noise type (Cellular: F1 mapped to [-1, 1]; Voronoi: F2 - F1).
float NoiseSample(uint3 Cell, float3 Frac, float3 Offset, int NoiseType, int Seed)
{
    if (NoiseType == VOXELGEN_NOISE_TYPE_PERLIN)
    {
        return NoisePerlin(Cell, Frac, Offset, Seed);
    }
    if (NoiseType == VOXELGEN_NOISE_TYPE_CELLULAR || NoiseType == VOXELGEN_NOISE_TYPE_VORONOI)
    {
        // One search for both, so it is inlined once (F2.13).
        const float2 Cel = NoiseCellular(Cell, Frac, Offset, Seed);
        return (NoiseType == VOXELGEN_NOISE_TYPE_CELLULAR) ? (Cel.x * 2.0f - 1.0f) : ((Cel.y - Cel.x) * 2.0f - 1.0f);
    }
    return NoiseSimplex(Cell, Frac, Offset, Seed);
}

/**
 * FVoxelNoise::FBM3D(Origin, Offset, Params): fBm at a field's origin (its splits at NoiseOrigins[OriginBase +
 * octave], uploaded by the CPU) + OffsetUU, the sample's offset from the origin in uu, scaled by each octave's frequency.
 * The octave loop is the classic FBM3D's: frequencies multiplied in float, amplitudes, normalisation.
 */
float NoiseFBM3D(int OriginBase, float3 OffsetUU, int NoiseType, int Seed, int Octaves, float Frequency, float Amplitude,
    float Lacunarity, float Persistence)
{
    float Total = 0.0f;
    float CurrentFrequency = Frequency;
    float CurrentAmplitude = Amplitude;
    float MaxValue = 0.0f;
    const int Count = clamp(Octaves, 1, 16);
    for (int i = 0; i < Count; ++i)
    {
        const int Index = (OriginBase + i) * 2;
        const uint3 Cell = asuint(NoiseOrigins[Index].xyz);
        const float3 Frac = NoiseOrigins[Index + 1].xyz;
        Total += NoiseSample(Cell, Frac, OffsetUU * CurrentFrequency, NoiseType, Seed) * CurrentAmplitude;
        MaxValue += CurrentAmplitude;
        CurrentAmplitude *= Persistence;
        CurrentFrequency *= Lacunarity;
    }
    return Total / MaxValue;
}
