//
// Planet noise on the GPU (spherical Phase 6, WM-BP5, D22; WORLD_MODES_REVIEW_PLAN.md §20.1): the twin of
// FVoxelPlanetNoise (VoxelPlanetNoise.cpp), the same float operations in the same order. A hashed integer lattice with no
// period and split-origin sampling: each field's origin is split per octave on the CPU, in double, into an integer
// lattice cell and a float fraction (PlanetNoiseOrigins, 2 float4s a split: [asfloat(cell), 0][frac, 0]), and the shader
// adds the voxel's small offset in noise units, so every float here is of the size of a lattice cell, at any radius.
// Heightmap worlds keep FBMNoise.ush bit for bit.
//
// Include AFTER the generation globals (GenerateVoxelDensity.usf): reads PlanetNoiseOrigins.

#pragma once

// FVoxelPlanetNoise::LatticeHash: wrapping multiplies, xors and shifts only (the ore Rarity hash's mixing).
uint PlanetLatticeHash(uint3 C, int Seed)
{
    uint H = C.x * 0x8DA6B343u;
    H ^= C.y * 0xD8163841u;
    H ^= C.z * 0xCB1AB31Fu;
    H ^= asuint(Seed) * 0x9E3779B9u;
    H ^= H >> 16;
    H *= 0x7FEB352Du;
    H ^= H >> 15;
    H *= 0x846CA68Bu;
    H ^= H >> 16;
    return H;
}

// The hash as a float in [0, 1): its top 24 bits.
float PlanetHashUnit(uint H)
{
    return (float)(H >> 8) * (1.0f / 16777216.0f);
}

static const int3 PlanetGrad3[12] = {
    int3(1,1,0), int3(-1,1,0), int3(1,-1,0), int3(-1,-1,0),
    int3(1,0,1), int3(-1,0,1), int3(1,0,-1), int3(-1,0,-1),
    int3(0,1,1), int3(0,-1,1), int3(0,1,-1), int3(0,-1,-1)
};

float PlanetSimplexCorner(uint Hash, float3 X)
{
    float R = 0.6f - X.x * X.x - X.y * X.y - X.z * X.z;
    if (R < 0.0f)
    {
        return 0.0f;
    }
    R *= R;
    const int3 G = PlanetGrad3[Hash % 12u];
    return R * R * ((float)G.x * X.x + (float)G.y * X.y + (float)G.z * X.z);
}

// FVoxelPlanetNoise::Simplex: Simplex noise at the split origin (Cell, Frac in the skewed lattice) + Offset (noise units).
float PlanetSimplex(uint3 Cell, float3 Frac, float3 Offset, int Seed)
{
    const float F3P = 1.0f / 3.0f;
    const float G3P = 1.0f / 6.0f;

    const float S = (Offset.x + Offset.y + Offset.z) * F3P;
    const float3 G = float3(Frac.x + (Offset.x + S), Frac.y + (Offset.y + S), Frac.z + (Offset.z + S));
    const int3 C = (int3)floor(G);
    const float3 F = G - (float3)C;

    const float T = (F.x + F.y + F.z) * G3P;
    const float3 X0 = F - T;

    int3 I1, I2;
    if (X0.x >= X0.y)
    {
        if (X0.y >= X0.z) { I1 = int3(1, 0, 0); I2 = int3(1, 1, 0); }
        else if (X0.x >= X0.z) { I1 = int3(1, 0, 0); I2 = int3(1, 0, 1); }
        else { I1 = int3(0, 0, 1); I2 = int3(1, 0, 1); }
    }
    else
    {
        if (X0.y < X0.z) { I1 = int3(0, 0, 1); I2 = int3(0, 1, 1); }
        else if (X0.x < X0.z) { I1 = int3(0, 1, 0); I2 = int3(0, 1, 1); }
        else { I1 = int3(0, 1, 0); I2 = int3(1, 1, 0); }
    }

    const float3 X1 = X0 - (float3)I1 + G3P;
    const float3 X2 = X0 - (float3)I2 + 2.0f * G3P;
    const float3 X3 = X0 - 1.0f + 3.0f * G3P;

    const uint3 B = Cell + asuint(C);
    const float N0 = PlanetSimplexCorner(PlanetLatticeHash(B, Seed), X0);
    const float N1 = PlanetSimplexCorner(PlanetLatticeHash(B + asuint(I1), Seed), X1);
    const float N2 = PlanetSimplexCorner(PlanetLatticeHash(B + asuint(I2), Seed), X2);
    const float N3 = PlanetSimplexCorner(PlanetLatticeHash(B + uint3(1u, 1u, 1u), Seed), X3);
    return 32.0f * (N0 + N1 + N2 + N3);
}

float PlanetGrad(uint Hash, float X, float Y, float Z)
{
    const uint H = Hash & 15u;
    const float U = H < 8u ? X : Y;
    const float V = H < 4u ? Y : ((H == 12u || H == 14u) ? X : Z);
    return ((H & 1u) == 0u ? U : -U) + ((H & 2u) == 0u ? V : -V);
}

float PlanetFade(float X)
{
    return X * X * X * (X * (X * 6.0f - 15.0f) + 10.0f);
}

float PlanetLerp(float A, float B, float Alpha)
{
    return A + Alpha * (B - A);
}

// FVoxelPlanetNoise::Perlin: improved gradient noise at the split origin (cube lattice) + Offset.
float PlanetPerlin(uint3 Cell, float3 Frac, float3 Offset, int Seed)
{
    const float3 G = Frac + Offset;
    const int3 C = (int3)floor(G);
    const float X = G.x - (float)C.x;
    const float Y = G.y - (float)C.y;
    const float Z = G.z - (float)C.z;
    const uint3 B = Cell + asuint(C);
    const float U = PlanetFade(X);
    const float V = PlanetFade(Y);
    const float W = PlanetFade(Z);
    return PlanetLerp(
        PlanetLerp(
            PlanetLerp(PlanetGrad(PlanetLatticeHash(B, Seed), X, Y, Z), PlanetGrad(PlanetLatticeHash(B + uint3(1u, 0u, 0u), Seed), X - 1.0f, Y, Z), U),
            PlanetLerp(PlanetGrad(PlanetLatticeHash(B + uint3(0u, 1u, 0u), Seed), X, Y - 1.0f, Z), PlanetGrad(PlanetLatticeHash(B + uint3(1u, 1u, 0u), Seed), X - 1.0f, Y - 1.0f, Z), U), V),
        PlanetLerp(
            PlanetLerp(PlanetGrad(PlanetLatticeHash(B + uint3(0u, 0u, 1u), Seed), X, Y, Z - 1.0f), PlanetGrad(PlanetLatticeHash(B + uint3(1u, 0u, 1u), Seed), X - 1.0f, Y, Z - 1.0f), U),
            PlanetLerp(PlanetGrad(PlanetLatticeHash(B + uint3(0u, 1u, 1u), Seed), X, Y - 1.0f, Z - 1.0f), PlanetGrad(PlanetLatticeHash(B + uint3(1u, 1u, 1u), Seed), X - 1.0f, Y - 1.0f, Z - 1.0f), U), V), W);
}

// FVoxelPlanetNoise::Cellular: (F1, F2) over the 3x3x3 cells around the split origin + Offset.
float2 PlanetCellular(uint3 Cell, float3 Frac, float3 Offset, int Seed)
{
    const float3 G = Frac + Offset;
    const int3 C = (int3)floor(G);
    const float3 F = G - (float3)C;
    const uint3 B = Cell + asuint(C);
    float F1 = 100.0f;
    float F2 = 100.0f;
    for (int DZ = -1; DZ <= 1; ++DZ)
    {
        for (int DY = -1; DY <= 1; ++DY)
        {
            for (int DX = -1; DX <= 1; ++DX)
            {
                const uint3 N = B + asuint(int3(DX, DY, DZ));
                const float DeltaX = (float)DX + PlanetHashUnit(PlanetLatticeHash(N, Seed)) - F.x;
                const float DeltaY = (float)DY + PlanetHashUnit(PlanetLatticeHash(N, Seed + 1)) - F.y;
                const float DeltaZ = (float)DZ + PlanetHashUnit(PlanetLatticeHash(N, Seed + 2)) - F.z;
                const float DistSq = DeltaX * DeltaX + DeltaY * DeltaY + DeltaZ * DeltaZ;
                if (DistSq < F1)
                {
                    F2 = F1;
                    F1 = DistSq;
                }
                else if (DistSq < F2)
                {
                    F2 = DistSq;
                }
            }
        }
    }
    return float2(sqrt(F1), sqrt(F2));
}

// FVoxelPlanetNoise::Sample: one octave of the noise type (Cellular: F1 mapped to [-1, 1]; Voronoi: F2 - F1).
float PlanetNoiseSample(uint3 Cell, float3 Frac, float3 Offset, int NoiseType, int Seed)
{
    if (NoiseType == NOISE_TYPE_PERLIN)
    {
        return PlanetPerlin(Cell, Frac, Offset, Seed);
    }
    if (NoiseType == NOISE_TYPE_CELLULAR)
    {
        return PlanetCellular(Cell, Frac, Offset, Seed).x * 2.0f - 1.0f;
    }
    if (NoiseType == NOISE_TYPE_VORONOI)
    {
        const float2 Cel = PlanetCellular(Cell, Frac, Offset, Seed);
        return (Cel.y - Cel.x) * 2.0f - 1.0f;
    }
    return PlanetSimplex(Cell, Frac, Offset, Seed);
}

/**
 * FVoxelPlanetNoise::FBM3D(Origin, Offset, Params): fBm at a field's origin (its splits at PlanetNoiseOrigins[OriginBase +
 * octave], uploaded by the CPU) + OffsetUU, the sample's offset from the origin in uu, scaled by each octave's frequency.
 * The octave loop is FBM3D's (FBMNoise.ush): frequencies multiplied in float, amplitudes, normalisation.
 */
float PlanetFBM3D(int OriginBase, float3 OffsetUU, int NoiseType, int Seed, int Octaves, float Frequency, float Amplitude,
    float Lacunarity, float Persistence)
{
    float Total = 0.0f;
    float CurrentFrequency = Frequency;
    float CurrentAmplitude = Amplitude;
    float MaxValue = 0.0f;
    const int Count = clamp(Octaves, 1, 16);
    for (int i = 0; i < Count; ++i)
    {
        const int Index = (OriginBase + i) * 2;
        const uint3 Cell = asuint(PlanetNoiseOrigins[Index].xyz);
        const float3 Frac = PlanetNoiseOrigins[Index + 1].xyz;
        Total += PlanetNoiseSample(Cell, Frac, OffsetUU * CurrentFrequency, NoiseType, Seed) * CurrentAmplitude;
        MaxValue += CurrentAmplitude;
        CurrentAmplitude *= Persistence;
        CurrentFrequency *= Lacunarity;
    }
    return Total / MaxValue;
}
