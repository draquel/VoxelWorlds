/**
 * Main compute shader for generating voxel density data.
 *
 * Generates a 3D grid of voxel data using noise-based terrain generation.
 * Each thread computes one voxel's density and packs it into the output buffer.
 *
 * Thread Group Size: [4, 4, 4] = 64 threads per group
 * Dispatch: ChunkSize/4 in each dimension
 */

#include "/Engine/Public/Platform.ush"
#include "/Plugin/VoxelWorlds/Private/VoxelNoiseCommon.ush"
#include "/Plugin/VoxelWorlds/Private/WorldModeSDF.ush"
#include "/Plugin/VoxelWorlds/Private/CaveGeneration.ush"

// ==================== Shader Parameters ====================

// Chunk world position (origin of this chunk)
float3 ChunkWorldPosition;

// Number of voxels per chunk edge
uint ChunkSize;

// Size of each voxel in world units
float VoxelSize;

// LOD level (voxel size multiplier = 2^LODLevel)
uint LODLevel;

// Noise parameters
int NoiseType;      // 0 = Perlin, 1 = Simplex
int NoiseSeed;
int NoiseOctaves;
float NoiseFrequency;
float NoiseAmplitude;
float NoiseLacunarity;
float NoisePersistence;

// World mode parameters
int WorldMode;      // 0 = InfinitePlane, 1 = SphericalPlanet, 2 = IslandBowl
float SeaLevel;
float HeightScale;
float BaseHeight;

// Continentalness parameters
int ContinentalnessEnabled;
int ContinentalnessSeed;
float ContinentalnessFrequency;
int ContinentalnessCurveSamples;
float4 ContinentalnessHeightCurve[8];    // 32 floats packed into 8 float4s
float4 ContinentalnessHeightScaleCurve[8];

// Cave parameters — packed as vectors (4 layers in .xyzw components)
int CaveEnabled;
int CaveLayerCount;
int4 CaveLayerType;
int4 CaveLayerSeed;
int4 CaveLayerSeed2;
float4 CaveLayerFrequency;
float4 CaveLayerFrequency2;
int4 CaveLayerOctaves;
float4 CaveLayerPersistence;
float4 CaveLayerLacunarity;
float4 CaveLayerThreshold;
float4 CaveLayerCarveStrength;
float4 CaveLayerCarveFalloff;
float4 CaveLayerMinDepth;
float4 CaveLayerMaxDepth;
float4 CaveLayerDepthFadeWidth;
float4 CaveLayerVerticalScale;

// Water level parameters
int WaterLevelEnabled;
float WaterLevelHeight;

// Biome / material parameters (Phase B) — see BiomeMaterial.ush + UVoxelBiomeConfiguration::BuildGpuData.
// BiomeCount == 0 falls back to the legacy depth-based material.
int BiomeCount;
float BiomeBlendWidth;
int TemperatureSeed;
float TemperatureFrequency;
int MoistureSeed;
float MoistureFrequency;
int EnableUnderwaterMaterials;
uint DefaultUnderwaterMaterial;
StructuredBuffer<float4> BiomeData;
// The blend zones' dither (G39): the chunk's first voxel on the world's grid (FVoxelBiomeBlendDither::GridBase), and
// voxel.Biome.BlendDither (0: the old pick).
int3 BlendDitherBase;
int BlendDitherMode;

// Height rules / ore veins / cave-wall / conditioning (Phase B) — layouts in BiomeMaterial.ush.
int HeightRuleCount;
StructuredBuffer<float4> HeightRuleData;
int OreVeinCount;
StructuredBuffer<float4> OreVeinData;
int CaveWallOverrideEnabled;
uint CaveWallMaterialID;
float CaveWallMaterialMinDepth;
int ConditioningZoneCount;
StructuredBuffer<float4> ConditioningZoneData;

// IslandBowl world-mode params (Phase C) — see IslandFalloff.ush.
int IslandShape;
int IslandFalloffType;
float IslandRadius;
float IslandSizeY;
float IslandFalloffWidth;
float IslandCenterX;
float IslandCenterY;
float IslandEdgeHeight;
float IslandSeabedDepth;      // WM-E1: the seabed beyond the edge slopes down by this much
float IslandSeabedSlopeWidth; // ... over this horizontal distance (0 = a step)

// SphericalPlanet world-mode params (spherical Phase 2, SP-B4) — see SphericalPlanet.ush. From the request's
// SphericalPlanetParams (FVoxelWorldModeFactory) and WaterRadius. Chunk-relative (spherical Phase 6, WM-BP6): nothing here
// is subtracted from another R-sized value in float; R itself only scales small directions.
float PlanetRadius;           // the datum
float PlanetMaxTerrainHeight; // FSphericalPlanetParams::MaxTerrainHeight (the shell's quick reject, as an altitude)
float PlanetMaxTerrainDepth;  // FSphericalPlanetParams::MaxTerrainDepth
float PlanetWaterAltitude;    // the sea as an altitude: WaterRadius - PlanetRadius, formed in double
int3 ChunkBaseInt;            // floor of the chunk origin, in double: the ore Rarity key's integer part (relative to the
                              // planet centre on a planet, absolute on a heightmap world since MP4)
float3 ChunkBaseFrac;         // the chunk origin less ChunkBaseInt

// The noise's per-chunk origins (spherical Phase 6, WM-BP5; every world mode since the world modes review's MP4, D39;
// VoxelNoise.ush): every field's origin split per octave on the CPU, in double, 2 float4s a split ([asfloat(cell), 0]
// [frac, 0]). The field bases index splits. On a planet the origins belong to the chunk's anchor (its centre): the 2D
// fields at the anchor's point on the datum sphere, each cave layer at the anchor with its altitude scaled, each ore at
// the anchor through its streak map (a first slot holds the streak's [direction, factor]); the anchor's direction, distance
// from the centre and altitude (computed in double) give each voxel's small differences (MakePlanetVoxelFrame). On a
// heightmap world the anchor is the chunk's origin corner: the 2D fields at (X, Y, 0), each cave layer at
// (X, Y, Z x VerticalScale), each ore at the corner through its streak map; a voxel's offset is its index times the voxel
// size (BuildNoiseOrigins in VoxelGPUNoiseGenerator.cpp).
StructuredBuffer<float4> NoiseOrigins;
int TerrainNoiseOrigin;
int ContinentNoiseOrigin;
int TemperatureNoiseOrigin;
int MoistureNoiseOrigin;
int4 CaveNoiseOrigin;        // per cave layer: field 1's splits, then field 2's (CaveLayerOctaves each)
int OreNoiseOrigin;          // per ore record (OreVeinData order): 3 splits, the streak slot then 2 octaves
float3 PlanetAnchorLocal;     // the anchor in the chunk: (ChunkSize / 2) x VoxelSize on each axis
float3 PlanetAnchorDir;       // the anchor's direction from the centre
float PlanetAnchorDist;       // the anchor's distance from the centre
float PlanetAnchorAltitude;   // that distance minus PlanetRadius, formed in double
int SimplexContinuous;  // G43: voxel.Planet.ContinuousSimplex (1: the continuous Simplex kernel; 0: the classic one)

// The cave configuration's underwater minimum depth and biome overrides, which GpuCaveCarve applies in every world mode
// as FVoxelCPUNoiseGenerator::CalculateCaveDensity does. CaveBiomeOverrideData: 1 float4 per override,
// [BiomeID, CaveScale, MinDepthOverride, 0] in the cave configuration's order (the first match wins).
float CaveUnderwaterMinDepth;
int CaveBiomeOverrideCount;
StructuredBuffer<float4> CaveBiomeOverrideData;

// Output buffer: packed voxel data (MaterialID | Density<<8 | BiomeID<<16 | Metadata<<24)
RWStructuredBuffer<uint> OutputVoxelData;

// Per-voxel biome selection + material pipeline (references the biome globals declared above).
#include "/Plugin/VoxelWorlds/Private/BiomeMaterial.ush"
// The planet noise (references NoiseOrigins) and the chunk frame.
#include "/Plugin/VoxelWorlds/Private/VoxelNoise.ush"
#include "/Plugin/VoxelWorlds/Private/PlanetFrame.ush"
// IslandBowl edge falloff (references the IslandBowl globals declared above).
#include "/Plugin/VoxelWorlds/Private/IslandFalloff.ush"

// ==================== Helpers shared by the world-mode branches ====================

/** A planet voxel in its chunk's frame (PlanetFrame.ush): the anchor is the chunk's centre. */
PlanetVoxelFrame MakePlanetVoxelFrame(uint3 VoxelCoord, float InVoxelSize)
{
    return MakePlanetFrameAt(float3(VoxelCoord) * InVoxelSize - PlanetAnchorLocal, PlanetAnchorDir, PlanetAnchorDist);
}

/**
 * The continentalness curves applied to the terrain params: the baked curves' height offset and height-scale multiplier
 * at a continentalness value, lerped between samples (FVoxelBiomeSnapshot::GetContinentalnessTerrainParams).
 *
 * @param ContinentalnessNoise The continentalness field's value
 * @param InOutBaseHeight Base height, the curve's offset added
 * @param InOutHeightScale Height scale, multiplied by the curve's multiplier
 * @return The continentalness value (the biome blend reuses it)
 */
float GpuContinentalnessCurves(float ContinentalnessNoise, inout float InOutBaseHeight, inout float InOutHeightScale)
{
    // Curve-based height offset lookup from baked samples (packed as float4[8])
    float FIdx = (ContinentalnessNoise + 1.0) * 0.5 * float(ContinentalnessCurveSamples - 1);
    int Idx0 = clamp(int(floor(FIdx)), 0, ContinentalnessCurveSamples - 2);
    int Idx1 = Idx0 + 1;
    float Frac = FIdx - float(Idx0);
    // Unpack scalar from float4: vec[i/4][i%4]
    float H0 = ContinentalnessHeightCurve[Idx0 / 4][Idx0 % 4];
    float H1 = ContinentalnessHeightCurve[Idx1 / 4][Idx1 % 4];
    float S0 = ContinentalnessHeightScaleCurve[Idx0 / 4][Idx0 % 4];
    float S1 = ContinentalnessHeightScaleCurve[Idx1 / 4][Idx1 % 4];
    float HeightOffset = lerp(H0, H1, Frac);
    float ScaleMult = lerp(S0, S1, Frac);

    InOutBaseHeight += HeightOffset;
    InOutHeightScale *= ScaleMult;
    return ContinentalnessNoise;
}

/**
 * Continentalness on a heightmap world, applied to the terrain params: the field at (X, Y, 0), sampled as the chunk's
 * continentalness origin (the corner's (X, Y, 0), split on the CPU) + the voxel's offset in the plane (MP4: the same noise
 * as the CPU's FInfinitePlaneWorldMode::ComputeEffectiveTerrainParamsAt, 2-octave Simplex, then the curves). A planet
 * samples the field on the datum sphere (SphericalPlanet.ush) and applies GpuContinentalnessCurves.
 *
 * @param Offset2D The voxel's offset from the chunk's origin corner, (dx, dy, 0)
 * @param InOutBaseHeight Base height, the curve's offset added
 * @param InOutHeightScale Height scale, multiplied by the curve's multiplier
 * @return The continentalness value (the biome blend reuses it)
 */
float GpuApplyContinentalness(float3 Offset2D, inout float InOutBaseHeight, inout float InOutHeightScale)
{
    const float ContinentalnessNoise = NoiseFBM3D(ContinentNoiseOrigin, Offset2D, VOXELGEN_NOISE_TYPE_SIMPLEX, ContinentalnessSeed, 2,
        ContinentalnessFrequency, 1.0f, 2.0f, 0.5f);
    return GpuContinentalnessCurves(ContinentalnessNoise, InOutBaseHeight, InOutHeightScale);
}

/**
 * One cave layer's carve on a heightmap world (FVoxelCPUNoiseGenerator::SampleCaveLayer: the noise at the voxel's position
 * with VerticalScale applied along Z), as the layer's origin (the chunk corner's (X, Y, Z x VerticalScale), split on the
 * CPU) + the voxel's offset with its Z scaled the same (MP4). A planet's is PlanetCaveLayerCarve.
 *
 * @param ci Cave layer index in [0, CaveLayerCount)
 * @param VoxelOffset The voxel's offset from the chunk's origin corner (its index times the voxel size)
 * @return Carve density [0, CarveStrength], before the depth fade
 */
float HeightmapCaveLayerCarve(int ci, float3 VoxelOffset)
{
    const float3 Offset = float3(VoxelOffset.x, VoxelOffset.y, VoxelOffset.z * CaveLayerVerticalScale[ci]);
    const int Base = CaveNoiseOrigin[ci];
    const int Octaves = CaveLayerOctaves[ci];
    const float Noise1 = NoiseFBM3D(Base, Offset, VOXELGEN_NOISE_TYPE_SIMPLEX, CaveLayerSeed[ci], Octaves, CaveLayerFrequency[ci], 1.0f,
        CaveLayerLacunarity[ci], CaveLayerPersistence[ci]);
    if (CaveLayerType[ci] == VOXELGEN_CAVE_TYPE_CHEESE)
    {
        return CheeseCarveFromNoise(Noise1, CaveLayerThreshold[ci], CaveLayerCarveFalloff[ci], CaveLayerCarveStrength[ci]);
    }
    const float Noise2 = NoiseFBM3D(Base + clamp(Octaves, 1, 16), Offset, VOXELGEN_NOISE_TYPE_SIMPLEX, CaveLayerSeed2[ci], Octaves,
        CaveLayerFrequency2[ci], 1.0f, CaveLayerLacunarity[ci], CaveLayerPersistence[ci]);
    return TunnelCarveFromNoise(Noise1, Noise2, CaveLayerThreshold[ci], CaveLayerCarveFalloff[ci], CaveLayerCarveStrength[ci]);
}

/**
 * One planet cave layer's carve (FVoxelCPUNoiseGenerator::SampleCaveLayer with a planet, WM-BP5): the planet noise at the
 * voxel's position relative to the centre with its altitude scaled by VerticalScale (ScaleAltitudeRelative), written as
 * the layer's origin (the anchor's scaled position, split on the CPU) + the voxel's offset from it:
 * DeltaDir (R + A0 VerticalScale) + Dir DeltaR VerticalScale.
 *
 * @param ci Cave layer index in [0, CaveLayerCount)
 * @param F The voxel in its chunk's frame
 * @return Carve density [0, CarveStrength], before the depth fade
 */
float PlanetCaveLayerCarve(int ci, PlanetVoxelFrame F)
{
    const float VS = CaveLayerVerticalScale[ci];
    const float3 Offset = F.DeltaDir * (PlanetRadius + PlanetAnchorAltitude * VS) + F.Dir * (F.DeltaR * VS);
    const int Base = CaveNoiseOrigin[ci];
    const int Octaves = CaveLayerOctaves[ci];
    const float Noise1 = NoiseFBM3D(Base, Offset, VOXELGEN_NOISE_TYPE_SIMPLEX, CaveLayerSeed[ci], Octaves, CaveLayerFrequency[ci], 1.0f,
        CaveLayerLacunarity[ci], CaveLayerPersistence[ci]);
    if (CaveLayerType[ci] == VOXELGEN_CAVE_TYPE_CHEESE)
    {
        return CheeseCarveFromNoise(Noise1, CaveLayerThreshold[ci], CaveLayerCarveFalloff[ci], CaveLayerCarveStrength[ci]);
    }
    const float Noise2 = NoiseFBM3D(Base + clamp(Octaves, 1, 16), Offset, VOXELGEN_NOISE_TYPE_SIMPLEX, CaveLayerSeed2[ci], Octaves,
        CaveLayerFrequency2[ci], 1.0f, CaveLayerLacunarity[ci], CaveLayerPersistence[ci]);
    return TunnelCarveFromNoise(Noise1, Noise2, CaveLayerThreshold[ci], CaveLayerCarveFalloff[ci], CaveLayerCarveStrength[ci]);
}

/** UVoxelCaveConfiguration::GetBiomeCaveScale / GetBiomeMinDepthOverride: the first override for the biome, else 1 / -1. */
void GpuCaveBiomeOverride(uint BiomeID, out float OutCaveScale, out float OutMinDepthOverride)
{
    OutCaveScale = 1.0f;
    OutMinDepthOverride = -1.0f;
    for (int o = 0; o < CaveBiomeOverrideCount; ++o)
    {
        const float4 Override = CaveBiomeOverrideData[o];
        if ((uint)(Override.x + 0.5f) == BiomeID)
        {
            OutCaveScale = Override.y;
            OutMinDepthOverride = Override.z;
            return;
        }
    }
}

/**
 * FVoxelCPUNoiseGenerator::CalculateCaveDensity, in every world mode: the biome's cave scale and minimum-depth override,
 * the underwater minimum depth when the column's terrain is under the sea, each layer's depth window and fades, the
 * union of the layers, the biome scale. A heightmap layer samples its noise at the chunk's cave origin + the voxel's
 * offset with VerticalScale applied along Z (HeightmapCaveLayerCarve); a planet's, PlanetCaveLayerCarve.
 *
 * @param VoxelOffset The voxel's offset from the chunk's origin corner (the heightmap modes; unread on a planet)
 * @param Planet The voxel in its chunk's frame (a planet; unread otherwise)
 * @param DepthBelowSurface Depth below the terrain, in voxels (along Z, or radial on a planet)
 * @param BiomeID Dominant biome (0 without biomes)
 * @param bUnderwater The column's terrain is under the sea (and water is on)
 * @param bPlanetFrame A literal at each call: true in the planet branch, false in the heightmap one. A runtime
 *        WorldMode test inlined (and, on FXC, ran) both layer samplers at every call (F2.13)
 * @return Carve density [0, 1]
 */
float GpuCaveCarve(float3 VoxelOffset, PlanetVoxelFrame Planet, float DepthBelowSurface, uint BiomeID, bool bUnderwater, bool bPlanetFrame)
{
    float BiomeCaveScale;
    float MinDepthOverride;
    GpuCaveBiomeOverride(BiomeID, BiomeCaveScale, MinDepthOverride);
    if (BiomeCaveScale <= 0.0f)
    {
        return 0.0f;
    }

    // The underwater minimum depth catches transition zones where the ocean biome is not assigned but the terrain is
    // still under the sea.
    if (bUnderwater && CaveUnderwaterMinDepth > 0.0f)
    {
        MinDepthOverride = (MinDepthOverride < 0.0f) ? CaveUnderwaterMinDepth : max(MinDepthOverride, CaveUnderwaterMinDepth);
    }

    float MaxCarveDensity = 0.0f;
    for (int ci = 0; ci < CaveLayerCount; ++ci)
    {
        const float FadeWidth = CaveLayerDepthFadeWidth[ci];
        const float MaxDepth = CaveLayerMaxDepth[ci];
        const float EffectiveMinDepth = (MinDepthOverride >= 0.0f) ? MinDepthOverride : CaveLayerMinDepth[ci];

        if (DepthBelowSurface < EffectiveMinDepth - FadeWidth)
        {
            continue;
        }
        if (MaxDepth > 0.0f && DepthBelowSurface > MaxDepth + FadeWidth)
        {
            continue;
        }

        float LayerCarve;
        if (bPlanetFrame)
        {
            LayerCarve = PlanetCaveLayerCarve(ci, Planet);
        }
        else
        {
            LayerCarve = HeightmapCaveLayerCarve(ci, VoxelOffset);
        }
        if (LayerCarve <= 0.0f)
        {
            continue;
        }

        if (DepthBelowSurface < EffectiveMinDepth)
        {
            LayerCarve *= smoothstep(0.0f, 1.0f, (DepthBelowSurface - (EffectiveMinDepth - FadeWidth)) / FadeWidth);
        }
        if (MaxDepth > 0.0f && DepthBelowSurface > MaxDepth)
        {
            LayerCarve *= smoothstep(0.0f, 1.0f, 1.0f - (DepthBelowSurface - MaxDepth) / FadeWidth);
        }

        MaxCarveDensity = max(MaxCarveDensity, LayerCarve);
    }

    return clamp(MaxCarveDensity * BiomeCaveScale, 0.0f, 1.0f);
}

/** Carve a cave out of a solid voxel's density (the CPU's "density - carve * 255", clamped). */
uint ApplyCaveCarve(uint Density, float CaveCarve)
{
    if (CaveCarve > 0.0f)
    {
        const float NewDensity = max(0.0f, float(Density) - CaveCarve * 255.0f);
        return (uint)clamp(NewDensity, 0.0f, 255.0f);
    }
    return Density;
}

// SphericalPlanet surface function and per-voxel pipeline (references the planet globals and the helpers above).
#include "/Plugin/VoxelWorlds/Private/SphericalPlanet.ush"

// ==================== Main Compute Shader ====================

[numthreads(4, 4, 4)]
void MainCS(
    uint3 GroupId : SV_GroupID,
    uint3 GroupThreadId : SV_GroupThreadID,
    uint3 DispatchThreadId : SV_DispatchThreadID)
{
    // Calculate voxel index in chunk
    uint3 VoxelCoord = DispatchThreadId;

    // Early out if outside chunk bounds
    if (VoxelCoord.x >= ChunkSize || VoxelCoord.y >= ChunkSize || VoxelCoord.z >= ChunkSize)
    {
        return;
    }

    // Calculate linear index for output buffer
    uint LinearIndex = VoxelCoord.x + VoxelCoord.y * ChunkSize + VoxelCoord.z * ChunkSize * ChunkSize;

    // Generate at BASE voxel size regardless of LOD — this MUST match the CPU generator
    // (VoxelCPUNoiseGenerator: "Always generate at base VoxelSize regardless of LOD level;
    // LOD stride is applied during meshing, not generation"). The chunk grid is flat: every
    // chunk spans ChunkSize*VoxelSize world units at all LODs, and the mesher sub-samples the
    // base-resolution voxel data with a 2^LOD stride. Scaling sample spacing by 2^LOD here (the
    // old behaviour) made GPU LOD>0 chunks span 2^LOD chunks of world area, desyncing them from
    // the mesher's base-resolution expectation → torn / cracked LOD bands.
    float EffectiveVoxelSize = VoxelSize;

    // Calculate world position for this voxel
    float3 WorldPos = ChunkWorldPosition + float3(VoxelCoord) * EffectiveVoxelSize;
    // The voxel's offset from the chunk's origin corner: what the heightmap noise fields add to their per-chunk origins
    // (MP4), so no float here is of the size of the absolute position.
    const float3 VoxelOffset = float3(VoxelCoord) * EffectiveVoxelSize;

    uint Density;
    uint MaterialID;
    uint BiomeID = 0u;
    uint Metadata = 0u;

    // Branch based on world mode. InfinitePlane and IslandBowl share the heightmap path (both apply
    // continentalness -> height); IslandBowl additionally applies its edge falloff below.
    if (WorldMode == VOXELGEN_WORLD_MODE_INFINITE_PLANE || WorldMode == VOXELGEN_WORLD_MODE_ISLAND_BOWL)
    {
        // The 2D fields (terrain, continentalness, climate) sample (X, Y, 0): their origins are the corner's (X, Y, 0).
        const float3 Offset2D = float3(VoxelOffset.x, VoxelOffset.y, 0.0f);

        // Apply continentalness height modulation
        float EffectiveBaseHeight = BaseHeight;
        float EffectiveHeightScale = HeightScale;
        float ContinentalnessValue = 0.0; // reused for the biome blend below (CPU: shared with height path)

        if (ContinentalnessEnabled != 0)
        {
            ContinentalnessValue = GpuApplyContinentalness(Offset2D, EffectiveBaseHeight, EffectiveHeightScale);
        }

        // Infinite Plane: 2D heightmap-based terrain. Decomposed (vs the monolithic ApplyInfinitePlaneSDF)
        // so terrain conditioning can flatten the height BEFORE the density is derived — matches the CPU
        // order: SampleTerrainNoise2D -> NoiseToTerrainHeight -> ApplyToHeight -> CalculateSignedDistance -> density.
        // The terrain noise at the chunk's terrain origin + the voxel's offset in the plane (MP4: FVoxelNoise's
        // hashed lattice, split origin and continuous Simplex kernel, as FVoxelCPUNoiseGenerator::FBM3D).
        float TerrainNoise = NoiseFBM3D(TerrainNoiseOrigin, Offset2D,
            NoiseType, NoiseSeed, NoiseOctaves, NoiseFrequency, NoiseAmplitude, NoiseLacunarity, NoisePersistence);
        float TerrainHeight = NoiseToTerrainHeight(TerrainNoise, SeaLevel, EffectiveHeightScale, EffectiveBaseHeight);
        // IslandBowl: fade the (continentalness-modulated) height toward EdgeHeight at the world edge.
        if (WorldMode == VOXELGEN_WORLD_MODE_ISLAND_BOWL)
        {
            TerrainHeight = ApplyIslandFalloffToHeight(WorldPos.x, WorldPos.y, TerrainHeight);
        }
        if (ConditioningZoneCount > 0)
        {
            TerrainHeight = GpuApplyConditioning(WorldPos.x, WorldPos.y, TerrainHeight);
        }
        Density = SignedDistanceToDensity(CalculateSignedDistance(WorldPos.z, TerrainHeight), EffectiveVoxelSize);

        // Depth below the terrain surface, in voxels (matches CPU: (TerrainHeight - WorldPos.Z) / VoxelSize).
        float DepthBelowSurface = (TerrainHeight - WorldPos.z) / EffectiveVoxelSize;

        // The biome blend comes before the caves, as on the CPU: the caves read the dominant biome's cave scale and
        // minimum-depth override (the cave configuration's BiomeOverrides).
        BiomeBlendResult Blend = (BiomeBlendResult)0;
        uint OreStart = 0u;
        uint OreCount = 0u;
        if (BiomeCount > 0)
        {
            // Temperature and moisture at (X, Y, 0): the chunk's climate origins + the voxel's offset in the plane
            const float Temperature = NoiseFBM3D(TemperatureNoiseOrigin, Offset2D, VOXELGEN_NOISE_TYPE_SIMPLEX, TemperatureSeed, 2, TemperatureFrequency, 1.0f, 2.0f, 0.5f);
            const float Moisture = NoiseFBM3D(MoistureNoiseOrigin, Offset2D, VOXELGEN_NOISE_TYPE_SIMPLEX, MoistureSeed, 2, MoistureFrequency, 1.0f, 2.0f, 0.5f);
            Blend = SampleGpuBiomeBlend(Temperature, Moisture, ContinentalnessValue);
            const GpuBiome Dominant = LoadGpuBiome(Blend.Indices[0]);
            BiomeID = Dominant.BiomeID;
            OreStart = Dominant.OreStart; // ore lookup uses the dominant biome (CPU: GetOreVeinsForBiome(BiomeID))
            OreCount = Dominant.OreCount;
        }

        // Cave carving BEFORE material selection (matches CPU order), with the biome's overrides and, where the column's
        // terrain is under the sea, the underwater minimum depth. Keep the carve for the cave-wall material override and
        // the solid->air transition flag.
        const bool bUnderwaterColumn = (WaterLevelEnabled != 0) && (TerrainHeight < WaterLevelHeight);
        uint PreCaveDensity = Density;
        float CaveCarve = 0.0f;
        if (CaveEnabled != 0 && Density >= 127u && DepthBelowSurface > 0.0f)
        {
            CaveCarve = GpuCaveCarve(VoxelOffset, (PlanetVoxelFrame)0, DepthBelowSurface, BiomeID, bUnderwaterColumn, false);
            Density = ApplyCaveCarve(Density, CaveCarve);
        }

        // Assign material: biome pipeline (Phase B) when biomes are configured, else legacy depth-based.
        if (BiomeCount > 0)
        {
            // Underwater materials when the column's terrain is under the sea (GetBlendedMaterialWithWater)
            const bool bUnderwaterMaterial = bUnderwaterColumn && (EnableUnderwaterMaterials != 0);
            MaterialID = GpuBlendedMaterial(Blend, DepthBelowSurface, bUnderwaterMaterial, BlendDitherBase + int3(VoxelCoord));

            // Height-based material overrides (snow at peaks, rock at altitude, etc.)
            MaterialID = ApplyGpuHeightRules(MaterialID, WorldPos.z, DepthBelowSurface);

            // Cave-wall material override (still-solid voxels partially carved near a cave boundary)
            if (CaveWallOverrideEnabled != 0 && CaveCarve > 0.0f && CaveCarve < 1.0f
                && Density >= 127u && DepthBelowSurface >= CaveWallMaterialMinDepth)
            {
                MaterialID = CaveWallMaterialID;
            }

            // Ore vein overrides (solid voxels well below surface; depth > 10 matches the CPU guard): since MP4 the
            // planet's ore path on a heightmap world too (GpuCheckPlanetOreVein): the ore noise at the chunk's ore origin +
            // the voxel's offset through the streak's linear map, the Rarity hash on the absolute position rounded to
            // whole uu (the chunk's integer base + the voxel's offset; the CPU's OreRarityKey)
            if (Density >= 127u && DepthBelowSurface > 10.0f)
            {
                uint OreMat;
                const int3 RarityKey = ChunkBaseInt + int3(floor(ChunkBaseFrac + VoxelOffset + 0.5f));
                if (GpuCheckPlanetOreVein(VoxelOffset, RarityKey, DepthBelowSurface, OreStart, OreCount, NoiseSeed, OreMat))
                {
                    MaterialID = OreMat;
                }
            }
        }
        else
        {
            MaterialID = GetMaterialForInfinitePlane(WorldPos.z, TerrainHeight, EffectiveVoxelSize);
        }

        // Per-voxel cave/underground flag when cave carving turned solid -> air (matches CPU). The CPU
        // ApplyWaterFillPass + ApplyUndergroundClassificationPass run after readback and refine these.
        if (PreCaveDensity >= 127u && Density < 127u)
        {
            Metadata = Metadata | ((VOXELGEN_FLAG_CAVE | VOXELGEN_FLAG_UNDERGROUND) << 4);
        }
    }
    else if (WorldMode == VOXELGEN_WORLD_MODE_SPHERICAL_PLANET)
    {
        // A planet: the radial height along the direction from the centre, materials by altitude, caves along local up
        // (SphericalPlanet.ush, the GPU twin of FVoxelCPUNoiseGenerator::GenerateChunkSphericalPlanet; spherical SP-B4).
        GeneratePlanetVoxel(VoxelCoord, WorldPos, EffectiveVoxelSize, Density, MaterialID, BiomeID, Metadata);
    }
    else
    {
        // Default: 3D noise generation for a world mode with no branch of its own (none today): the terrain noise at the
        // chunk's terrain origin (the corner's (X, Y, 0)) + the voxel's offset with its absolute Z
        float NoiseValue = NoiseFBM3D(TerrainNoiseOrigin,
            float3(VoxelOffset.x, VoxelOffset.y, ChunkWorldPosition.z + VoxelOffset.z),
            NoiseType,
            NoiseSeed,
            NoiseOctaves,
            NoiseFrequency,
            NoiseAmplitude,
            NoiseLacunarity,
            NoisePersistence
        );

        // Convert noise to density
        Density = NoiseToDensity(NoiseValue);

        // Simple height-based material
        MaterialID = (WorldPos.z < 0.0f) ? 1u : 0u;
    }

    // Pack voxel data
    uint PackedData = PackVoxelData(MaterialID, Density, BiomeID, Metadata);

    // Write to output buffer
    OutputVoxelData[LinearIndex] = PackedData;
}
