/**
 * GPU ports of the CPU generation post-passes (water fill + underground classification).
 *
 * These run in the same render graph as GenerateVoxelDensity.usf, operating in-place on the
 * packed voxel buffer, so the readback returns finished voxel data and the game thread /
 * worker threads do no per-voxel work. Semantics mirror FVoxelCPUNoiseGenerator::
 * ApplyWaterFillPass / ApplyUndergroundClassificationPass exactly — any change here must be
 * mirrored there (the GPUvsCPU parity tests compare the two paths bit-for-bit). On a planet
 * (spherical Phase 2) the water fill is ApplyRadialWaterFillPass and the underground scan runs
 * along local down: WaterLineSeedCS, WaterFloodSweepRadialCS and UndergroundLinesCS, on the
 * CPU passes' own lines (FVoxelDownLines).
 *
 * Packed voxel layout (FVoxelData::Pack): byte0 material, byte1 density, byte2 biome,
 * byte3 metadata (AO low nibble, flags high nibble).
 */

#include "/Engine/Public/Platform.ush"
#include "/Plugin/VoxelWorlds/Private/PlanetFrame.ush"

// Voxel metadata flag bits — match FVoxelData::VOXEL_FLAG_* (stored in the high nibble of Metadata).
#define VOXEL_FLAG_WATER 0x01u
#define VOXEL_FLAG_CAVE 0x02u
#define VOXEL_FLAG_UNDERGROUND 0x04u

// Packed-word bit positions of the flag nibble (metadata byte 3, flags in its high nibble).
#define PACKED_WATER_BIT (VOXEL_FLAG_WATER << 28)
#define PACKED_CAVE_BIT (VOXEL_FLAG_CAVE << 28)
#define PACKED_UNDERGROUND_BIT (VOXEL_FLAG_UNDERGROUND << 28)

// FVoxelData::IsSolid — density byte >= VOXEL_SURFACE_THRESHOLD (127)
#define VOXEL_SURFACE_THRESHOLD 127u

uint ChunkSize;
float VoxelSize;          // Base voxel size — the CPU passes intentionally use Request.VoxelSize, not the LOD-effective size
float ChunkWorldZ;        // Chunk origin Z (world units)
float WaterLevel;
uint SweepAxis;           // WaterFloodSweepCS: 0 = X, 1 = Y, 2 = Z
uint ClearCaveFlags;      // UndergroundColumnCS / UndergroundLinesCS: 1 = clear cave flags while scanning (water pass phase 3)

// Planets (spherical Phase 2, SP-B7 / SP-B8 on the GPU): the digital lines along the chunk's local down that the CPU
// passes walk (FVoxelDownLines), and the sea sphere. The C++ computes the lines in double and uploads them as they are.
uint LineAxisA;           // the axis nearest to local down: 0 = X, 1 = Y, 2 = Z (the lines step along it)
uint LineForward;         // 1 when down points along +LineAxisA (lines start at index 0), else along -LineAxisA
StructuredBuffer<int2> LineShifts;  // per step K in [0, ChunkSize): the line's offset on (AxisA + 1) % 3 and (AxisA + 2) % 3
// The sea test in the chunk's frame (spherical Phase 6, WM-BP6; PlanetFrame.ush): a voxel is below the sea when its
// altitude (the anchor's + the small difference of its distance) is at or under the sea's, both formed without an R-sized
// cancellation (a float |P - C|^2 against WaterRadius^2 jitters by 8 uu at R 1e8).
float3 PlanetAnchorLocal; // the chunk's anchor (its centre) in the chunk
float3 PlanetAnchorDir;   // the anchor's direction from the planet centre
float PlanetAnchorDist;   // the anchor's distance from the planet centre
float PlanetSeaAltitudeOverAnchor; // WaterRadius - |anchor|, formed in double: below the sea when DeltaR <= this

RWStructuredBuffer<uint> VoxelData;
RWStructuredBuffer<uint> ScratchFlags;   // UndergroundMark/Apply: 1 uint per voxel, 1 = flag this voxel

uint LinearIndex(uint X, uint Y, uint Z)
{
    return X + Y * ChunkSize + Z * ChunkSize * ChunkSize;
}

bool IsSolid(uint Packed)
{
    return ((Packed >> 8) & 0xFFu) >= VOXEL_SURFACE_THRESHOLD;
}

// FVoxelSeaSurface::IsBelow for a planet's sea sphere, in the chunk's frame.
bool IsBelowSeaSphere(uint3 Local)
{
    return PlanetFrameDeltaR(float3(Local) * VoxelSize - PlanetAnchorLocal, PlanetAnchorDir, PlanetAnchorDist) <= PlanetSeaAltitudeOverAnchor;
}

// The voxel a digital line (FVoxelDownLines) visits at step K, if it is inside the chunk. LineB / LineC are the line's
// ids on the two sheared axes, in [-ChunkSize, 2 * ChunkSize).
bool DownLineVoxel(int LineB, int LineC, uint K, out uint3 Local)
{
    Local = uint3(0, 0, 0);
    const int2 Shift = LineShifts[K];
    const int B = LineB + Shift.x;
    const int C = LineC + Shift.y;
    if (B < 0 || B >= (int)ChunkSize || C < 0 || C >= (int)ChunkSize)
    {
        return false;
    }
    const uint A = (LineForward != 0) ? K : ChunkSize - 1u - K;
    // Local[AxisA] = A, Local[(AxisA + 1) % 3] = B, Local[(AxisA + 2) % 3] = C
    if (LineAxisA == 0u)
    {
        Local = uint3(A, (uint)B, (uint)C);
    }
    else if (LineAxisA == 1u)
    {
        Local = uint3((uint)C, A, (uint)B);
    }
    else
    {
        Local = uint3((uint)B, (uint)C, A);
    }
    return true;
}

// A line id from the dispatch: FVoxelDownLines's (B - ShiftB + N) + (C - ShiftC + N) * 3N, decoded.
bool DownLineFromThread(uint LineId, out int LineB, out int LineC)
{
    const uint Span = 3u * ChunkSize;
    LineB = (int)(LineId % Span) - (int)ChunkSize;
    LineC = (int)(LineId / Span) - (int)ChunkSize;
    return LineId < Span * Span;
}

// ==================== Water fill: phase 1 — column seed ====================
// One thread per XY column. Mirrors ApplyWaterFillPass phase 1: if the column is open from the
// chunk top down to the water level (no solid / cave-flagged voxels), flag water from the water
// level downward until a solid or cave barrier. Dispatched only when the chunk contains the
// water level (matching the CPU bChunkContainsWaterLevel gate).
[numthreads(8, 8, 1)]
void WaterColumnSeedCS(uint3 ThreadId : SV_DispatchThreadID)
{
    const uint X = ThreadId.x;
    const uint Y = ThreadId.y;
    if (X >= ChunkSize || Y >= ChunkSize)
    {
        return;
    }

    const int WaterZ = clamp((int)floor((WaterLevel - ChunkWorldZ) / VoxelSize), 0, (int)ChunkSize - 1);

    // Openness check from the chunk top down to (exclusive) the water level.
    if (WaterZ < (int)ChunkSize - 1)
    {
        for (int Z = (int)ChunkSize - 1; Z > WaterZ; --Z)
        {
            const uint Packed = VoxelData[LinearIndex(X, Y, (uint)Z)];
            if (IsSolid(Packed) || (Packed & PACKED_CAVE_BIT) != 0)
            {
                return; // column blocked above water level — underground, no seeding
            }
        }
    }

    // Flag water from the water level downward, stopping at a solid or cave barrier.
    for (int Z = WaterZ; Z >= 0; --Z)
    {
        const uint Index = LinearIndex(X, Y, (uint)Z);
        const uint Packed = VoxelData[Index];
        if (IsSolid(Packed) || (Packed & PACKED_CAVE_BIT) != 0)
        {
            break;
        }
        VoxelData[Index] = Packed | PACKED_WATER_BIT;
    }
}

// ==================== Water fill: phase 1 on a planet — line seed ====================
// One thread per digital line along the chunk's local down (FVoxelDownLines). Mirrors ApplyRadialWaterFillPass phase
// 1: walking the line from where it enters the chunk, the first solid or cave voxel blocks the rest of the line; until
// then, air inside the sea sphere takes the water flag. Each voxel is on exactly one line and a line reads and writes
// only its own voxels, so the threads are independent and the result is the CPU's. Dispatched only when the sea
// surface crosses the chunk's voxel box (the CPU's gate, evaluated in C++).
[numthreads(64, 1, 1)]
void WaterLineSeedCS(uint3 ThreadId : SV_DispatchThreadID)
{
    int LineB, LineC;
    if (!DownLineFromThread(ThreadId.x, LineB, LineC))
    {
        return;
    }

    for (uint K = 0; K < ChunkSize; ++K)
    {
        uint3 Local;
        if (!DownLineVoxel(LineB, LineC, K, Local))
        {
            continue;
        }
        const uint Index = LinearIndex(Local.x, Local.y, Local.z);
        const uint Packed = VoxelData[Index];
        if (IsSolid(Packed) || (Packed & PACKED_CAVE_BIT) != 0)
        {
            return; // the line is blocked from here on
        }
        if (IsBelowSeaSphere(Local))
        {
            VoxelData[Index] = Packed | PACKED_WATER_BIT;
        }
    }
}

// ==================== Water fill: phase 2 — flood sweep ====================
// One thread per line along SweepAxis; bidirectional carry scan. Water spreads to a voxel if it
// is non-solid, non-cave, and below the sea — at or below the water level by its world Z
// (WaterFloodSweepCS), or inside the sea sphere on a planet (WaterFloodSweepRadialCS) — the exact
// eligibility of the CPU BFS. Water propagation is a monotone fixpoint (order-independent), so
// repeated axis sweeps converge to the same result as the CPU's BFS; the C++ side dispatches
// enough rounds for convergence on real terrain topology.
bool IsFloodBelowSea(uint X, uint Y, uint Z, bool bRadial)
{
    if (bRadial)
    {
        return IsBelowSeaSphere(uint3(X, Y, Z));
    }
    return (ChunkWorldZ + (float)Z * VoxelSize) <= WaterLevel;
}

void WaterFloodSweep(uint3 ThreadId, bool bRadial)
{
    if (ThreadId.x >= ChunkSize || ThreadId.y >= ChunkSize)
    {
        return;
    }

    const uint N = ChunkSize;

    // Map (ThreadId.xy) to the two fixed axes for this sweep direction.
    // SweepAxis 0: line along X, fixed (Y=t.x, Z=t.y)
    // SweepAxis 1: line along Y, fixed (X=t.x, Z=t.y)
    // SweepAxis 2: line along Z, fixed (X=t.x, Y=t.y)

    bool bCarry;

    // Forward pass
    bCarry = false;
    for (uint I = 0; I < N; ++I)
    {
        uint X = (SweepAxis == 0) ? I : ThreadId.x;
        uint Y = (SweepAxis == 1) ? I : ((SweepAxis == 0) ? ThreadId.x : ThreadId.y);
        uint Z = (SweepAxis == 2) ? I : ThreadId.y;

        const uint Index = LinearIndex(X, Y, Z);
        const uint Packed = VoxelData[Index];

        // [branch]: FXC cannot flatten the UAV write in the else-if (an internal error, then a DXC cross-compile).
        [branch]
        if ((Packed & PACKED_WATER_BIT) != 0)
        {
            bCarry = true;
        }
        else if (bCarry
            && !IsSolid(Packed)
            && (Packed & PACKED_CAVE_BIT) == 0
            && IsFloodBelowSea(X, Y, Z, bRadial))
        {
            VoxelData[Index] = Packed | PACKED_WATER_BIT;
        }
        else
        {
            bCarry = false;
        }
    }

    // Backward pass
    bCarry = false;
    for (int J = (int)N - 1; J >= 0; --J)
    {
        const uint I = (uint)J;
        uint X = (SweepAxis == 0) ? I : ThreadId.x;
        uint Y = (SweepAxis == 1) ? I : ((SweepAxis == 0) ? ThreadId.x : ThreadId.y);
        uint Z = (SweepAxis == 2) ? I : ThreadId.y;

        const uint Index = LinearIndex(X, Y, Z);
        const uint Packed = VoxelData[Index];

        // [branch]: FXC cannot flatten the UAV write in the else-if (an internal error, then a DXC cross-compile).
        [branch]
        if ((Packed & PACKED_WATER_BIT) != 0)
        {
            bCarry = true;
        }
        else if (bCarry
            && !IsSolid(Packed)
            && (Packed & PACKED_CAVE_BIT) == 0
            && IsFloodBelowSea(X, Y, Z, bRadial))
        {
            VoxelData[Index] = Packed | PACKED_WATER_BIT;
        }
        else
        {
            bCarry = false;
        }
    }
}

[numthreads(8, 8, 1)]
void WaterFloodSweepCS(uint3 ThreadId : SV_DispatchThreadID)
{
    WaterFloodSweep(ThreadId, false);
}

[numthreads(8, 8, 1)]
void WaterFloodSweepRadialCS(uint3 ThreadId : SV_DispatchThreadID)
{
    WaterFloodSweep(ThreadId, true);
}

// ==================== Underground classification: pass 1 — column scan ====================
// One thread per XY column, top-down state machine. Mirrors ApplyUndergroundClassificationPass
// pass 1: [optional solid at top] → air → solid (>= MinSolidThickness) → air = underground.
// When ClearCaveFlags is set (i.e. the water pass ran), also clears the temporary cave flag on
// every voxel — the CPU water pass phase 3 — which is safe to fold in here because this pass
// never reads cave flags.
[numthreads(8, 8, 1)]
void UndergroundColumnCS(uint3 ThreadId : SV_DispatchThreadID)
{
    const uint X = ThreadId.x;
    const uint Y = ThreadId.y;
    if (X >= ChunkSize || Y >= ChunkSize)
    {
        return;
    }

    const int MinSolidThickness = 3;

    bool bSeenAir = false;
    bool bUnderground = false;
    int ConsecutiveSolid = 0;

    for (int Z = (int)ChunkSize - 1; Z >= 0; --Z)
    {
        const uint Index = LinearIndex(X, Y, (uint)Z);
        uint Packed = VoxelData[Index];
        bool bDirty = false;

        if (ClearCaveFlags != 0 && (Packed & PACKED_CAVE_BIT) != 0)
        {
            Packed &= ~PACKED_CAVE_BIT;
            bDirty = true;
        }

        if (IsSolid(Packed))
        {
            if (bSeenAir)
            {
                ++ConsecutiveSolid;
            }
        }
        else
        {
            bSeenAir = true;

            if (!bUnderground && ConsecutiveSolid >= MinSolidThickness)
            {
                bUnderground = true;
            }

            if (bUnderground && (Packed & PACKED_WATER_BIT) == 0)
            {
                Packed |= PACKED_UNDERGROUND_BIT;
                bDirty = true;
            }

            if (!bUnderground)
            {
                ConsecutiveSolid = 0;
            }
        }

        if (bDirty)
        {
            VoxelData[Index] = Packed;
        }
    }
}

// ==================== Underground classification: pass 1 on a planet — line scan ====================
// One thread per digital line along the chunk's local down (FVoxelDownLines). Mirrors the planet branch of
// ApplyUndergroundClassificationPass pass 1 (SP-B7): the column scan's state machine on each line, from where it
// enters the chunk on its upper side. A world-Z scan would read a hillside at mid latitudes as a cave ceiling. As in
// UndergroundColumnCS, ClearCaveFlags folds in the water pass's phase 3 (every voxel is on exactly one line, so every
// voxel is cleared once). Heightmap chunks keep UndergroundColumnCS.
[numthreads(64, 1, 1)]
void UndergroundLinesCS(uint3 ThreadId : SV_DispatchThreadID)
{
    int LineB, LineC;
    if (!DownLineFromThread(ThreadId.x, LineB, LineC))
    {
        return;
    }

    const int MinSolidThickness = 3;

    bool bSeenAir = false;
    bool bUnderground = false;
    int ConsecutiveSolid = 0;

    for (uint K = 0; K < ChunkSize; ++K)
    {
        uint3 Local;
        if (!DownLineVoxel(LineB, LineC, K, Local))
        {
            continue;
        }
        const uint Index = LinearIndex(Local.x, Local.y, Local.z);
        uint Packed = VoxelData[Index];
        bool bDirty = false;

        if (ClearCaveFlags != 0 && (Packed & PACKED_CAVE_BIT) != 0)
        {
            Packed &= ~PACKED_CAVE_BIT;
            bDirty = true;
        }

        if (IsSolid(Packed))
        {
            if (bSeenAir)
            {
                ++ConsecutiveSolid;
            }
        }
        else
        {
            bSeenAir = true;

            if (!bUnderground && ConsecutiveSolid >= MinSolidThickness)
            {
                bUnderground = true;
            }

            if (bUnderground && (Packed & PACKED_WATER_BIT) == 0)
            {
                Packed |= PACKED_UNDERGROUND_BIT;
                bDirty = true;
            }

            if (!bUnderground)
            {
                ConsecutiveSolid = 0;
            }
        }

        if (bDirty)
        {
            VoxelData[Index] = Packed;
        }
    }
}

// ==================== Underground classification: pass 2 — boundary propagation ====================
// Two-phase Jacobi iteration (mark into scratch, then apply) so the parallel result is
// deterministic and matches the CPU's two-phase pass exactly. One iteration extends the
// underground flag onto solid voxels adjacent to underground air, guarded against voxels that
// also touch surface air. The C++ side dispatches Mark+Apply PropagationDepth (2) times.
[numthreads(4, 4, 4)]
void UndergroundMarkCS(uint3 ThreadId : SV_DispatchThreadID)
{
    const uint X = ThreadId.x;
    const uint Y = ThreadId.y;
    const uint Z = ThreadId.z;
    if (X >= ChunkSize || Y >= ChunkSize || Z >= ChunkSize)
    {
        return;
    }

    const uint Index = LinearIndex(X, Y, Z);
    const uint Packed = VoxelData[Index];

    uint Mark = 0;
    if (IsSolid(Packed) && (Packed & PACKED_UNDERGROUND_BIT) == 0)
    {
        bool bAdjacentToUnderground = false;
        bool bAdjacentToSurfaceAir = false;

        const int3 Offsets[6] =
        {
            int3(-1, 0, 0), int3(1, 0, 0),
            int3(0, -1, 0), int3(0, 1, 0),
            int3(0, 0, -1), int3(0, 0, 1)
        };

        [unroll]
        for (int N = 0; N < 6; ++N)
        {
            const int3 P = int3((int)X, (int)Y, (int)Z) + Offsets[N];
            if (P.x < 0 || P.x >= (int)ChunkSize ||
                P.y < 0 || P.y >= (int)ChunkSize ||
                P.z < 0 || P.z >= (int)ChunkSize)
            {
                continue;
            }

            const uint NbrPacked = VoxelData[LinearIndex((uint)P.x, (uint)P.y, (uint)P.z)];
            if ((NbrPacked & PACKED_UNDERGROUND_BIT) != 0)
            {
                bAdjacentToUnderground = true;
            }
            else if (!IsSolid(NbrPacked))
            {
                bAdjacentToSurfaceAir = true;
            }
        }

        if (bAdjacentToUnderground && !bAdjacentToSurfaceAir)
        {
            Mark = 1;
        }
    }

    ScratchFlags[Index] = Mark;
}

[numthreads(4, 4, 4)]
void UndergroundApplyCS(uint3 ThreadId : SV_DispatchThreadID)
{
    const uint X = ThreadId.x;
    const uint Y = ThreadId.y;
    const uint Z = ThreadId.z;
    if (X >= ChunkSize || Y >= ChunkSize || Z >= ChunkSize)
    {
        return;
    }

    const uint Index = LinearIndex(X, Y, Z);
    if (ScratchFlags[Index] != 0)
    {
        VoxelData[Index] |= PACKED_UNDERGROUND_BIT;
    }
}
