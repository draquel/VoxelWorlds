//
// GPU port of the spherical planet's generation (spherical Phase 2, SP-B4; WORLD_MODES_REVIEW_PLAN.md §16). Mirrors
// FSphericalPlanetWorldMode's surface function (SampleRadialDisplacement, ShellSignedDistance, ScaleAltitude) and the
// per-voxel pipeline of FVoxelCPUNoiseGenerator::GenerateChunkSphericalPlanet, in the same order, so GPU and CPU planets
// match (VoxelWorlds.Generation.GPUvsCPUSphericalParity). Any change here must be mirrored there.
//
// Include AFTER the generation globals (GenerateVoxelDensity.usf), BiomeMaterial.ush, PlanetNoise.ush and the shared
// helpers MakePlanetVoxelFrame / GpuContinentalnessCurves / GpuCaveCarve (caves along local up): this file reads the
// Planet*, Cave*, biome, ore and water globals.
//
// Precision (spherical Phase 6, WM-BP5 / WM-BP6): chunk-relative. Each voxel is its offset from the chunk's anchor in the
// anchor's frame (MakePlanetVoxelFrame, PlanetFrame.ush): its altitude is the anchor's (formed in double on the CPU) + a
// small difference, its point on the datum sphere the anchor's + a small tangent offset, so the SDF, the depth, the sea
// test and the conditioning distances never subtract two R-sized floats. Every noise field samples the planet noise (D22)
// at its per-chunk origin + the voxel's offset; the ore Rarity key is the chunk's integer base + the voxel's offset.

/** FSphericalPlanetWorldMode::ShellSignedDistanceAtAltitude: TerrainAltitude - VoxelAltitude, held at -1000 (air) more
 *  than 1000 uu above MaxTerrainHeight and at +1000 (core) more than 1000 uu below -MaxTerrainDepth. */
float PlanetShellSignedDistance(float VoxelAltitude, float TerrainAltitude)
{
    if (VoxelAltitude > PlanetMaxTerrainHeight + 1000.0f)
    {
        return -1000.0f;
    }
    if (VoxelAltitude < -PlanetMaxTerrainDepth - 1000.0f)
    {
        return 1000.0f;
    }
    return TerrainAltitude - VoxelAltitude;
}

/**
 * FVoxelTerrainConditioning::ApplyToAltitude (spherical SP-B10, D15): blend the terrain's altitude along a direction
 * toward each planet zone's target altitude by its weight, the great-circle distance from the zone's centre on the datum
 * sphere through GetWeightAtDistance's profile, layered in order. The CPU uploads a planet's zones as 2 float4s each:
 * [the zone's datum point relative to the chunk anchor's, InnerRadius][FalloffWidth, TargetAltitude, Strength, 0] (the
 * heightmap packing is GpuApplyConditioning's). The distance comes from the short chord between the voxel's datum point
 * and the zone's, both relative to the anchor's (WM-BP6): arc = 2 R asin(chord / 2R), with no R-sized cancellation; the
 * CPU's R atan2(|a x b|, a . b) in double is the same arc.
 *
 * @param SurfaceOffset The voxel's datum-sphere point relative to the anchor's (R x DeltaDir)
 * @param Altitude The natural terrain altitude
 */
float PlanetApplyConditioning(float3 SurfaceOffset, float Altitude)
{
    float A = Altitude;
    for (int z = 0; z < ConditioningZoneCount; ++z)
    {
        const float4 c0 = ConditioningZoneData[z * 2 + 0];
        const float4 c1 = ConditioningZoneData[z * 2 + 1];
        const float3 zoneOffset = c0.xyz;
        const float innerRadius = c0.w;
        const float falloffWidth = c1.x;
        const float targetAltitude = c1.y;
        const float strength = c1.z;

        const float chord = length(SurfaceOffset - zoneOffset);
        // asin by its series below 0.1 (the next term is under 1e-10 of it): D3D11 bytecode has no asin, and FXC expands
        // it to a polynomial with up to 5e-5 rad of error, which 2R turns into uu-scale errors at the pad's edge
        // (GPUvsCPUSphericalParity's pads at 71.6-99.1% on D3D11; F2.13). The D3D12 output is the same either way.
        const float x = min(1.0f, chord / (2.0f * PlanetRadius));
        const float x2 = x * x;
        const float asinX = (x < 0.1f) ? x * (1.0f + x2 * (1.0f / 6.0f + x2 * (3.0f / 40.0f + x2 * (5.0f / 112.0f)))) : asin(x);
        const float dist = 2.0f * PlanetRadius * asinX;

        float w;
        if (dist <= innerRadius)
        {
            w = strength;
        }
        else
        {
            const float falloff = max(1.0, falloffWidth);
            if (dist >= innerRadius + falloff)
            {
                w = 0.0;
            }
            else
            {
                const float t = (dist - innerRadius) / falloff;
                const float s = 1.0 - (t * t * (3.0 - 2.0 * t)); // smoothstep 1 -> 0
                w = strength * s;
            }
        }

        if (w > 0.0) { A = lerp(A, targetAltitude, w); }
    }
    return A;
}

/** FSphericalPlanetWorldMode::GetMaterialAtDepth (no biomes): grass, dirt, stone by radial depth in uu. */
uint GetMaterialForPlanet(float DepthBelowSurfaceUU)
{
    if (DepthBelowSurfaceUU < 0.0f)
    {
        return 0u;
    }
    if (DepthBelowSurfaceUU < 100.0f)
    {
        return 0u; // EVoxelMaterial::Grass
    }
    if (DepthBelowSurfaceUU < 400.0f)
    {
        return 1u; // EVoxelMaterial::Dirt
    }
    return 2u; // EVoxelMaterial::Stone
}

/**
 * A planet's ore vein noise (FVoxelCPUNoiseGenerator::SamplePlanetOreVeinNoise, WM-BP5): the 2-octave field at the ore's
 * frequency and seed by the planet noise, at the ore's origin (the anchor through its streak map, split on the CPU) + the
 * voxel's offset through the same map (D - dir (dir.D) k: the streak squashes one direction per ore type).
 *
 * @param OreIdx Ore record index (OreVeinData)
 * @param D The voxel's offset from the chunk's anchor
 * @param WorldSeed World seed
 * @return Noise in [0, 1]
 */
float PlanetOreVeinNoise(uint OreIdx, float3 D, int WorldSeed)
{
    const float4 o1 = OreVeinData[OreIdx * 3 + 1];
    const int SeedOffset = (int)o1.z;
    const int Base = OreNoiseOrigin + (int)OreIdx * 3;
    const float4 Streak = NoiseOrigins[Base * 2]; // [direction, 1 - 1 / StreakStretch] (factor 0 for a blob)
    const float3 Offset = D - Streak.xyz * (dot(D, Streak.xyz) * Streak.w);
    const float NoiseValue = PlanetFBM3D(Base + 1, Offset, NOISE_TYPE_SIMPLEX, WorldSeed + SeedOffset, 2, o1.x, 1.0f, 2.0f, 0.5f);
    return (NoiseValue + 1.0f) * 0.5f;
}

/**
 * FVoxelCPUNoiseGenerator::CheckOreVeinPlacement on a planet over [OreStart, OreStart + OreCount): the planet ore noise,
 * the Rarity test hashing the planet-relative position (SP-H3). First match wins.
 *
 * @param D The voxel's offset from the chunk's anchor (the noise)
 * @param RarityKey The voxel's OreRarityKey (its planet-relative position rounded to whole uu)
 */
bool GpuCheckPlanetOreVein(float3 D, int3 RarityKey, float DepthBelowSurface, uint OreStart, uint OreCount, int WorldSeed, out uint OutMat)
{
    OutMat = 0u;
    for (uint i = 0; i < OreCount; ++i)
    {
        const uint Idx = OreStart + i;
        const float4 o0 = OreVeinData[Idx * 3 + 0];
        const float4 o1 = OreVeinData[Idx * 3 + 1];
        const float MinDepth = o0.y;
        const float MaxDepth = o0.z;
        if (DepthBelowSurface < MinDepth) { continue; }
        if (MaxDepth > 0.0f && DepthBelowSurface > MaxDepth) { continue; }

        if (PlanetOreVeinNoise(Idx, D, WorldSeed) >= o1.y)
        {
            if (o1.w < 1.0f && GpuOreRarityHashKey(RarityKey, WorldSeed) > o1.w)
            {
                continue;
            }
            OutMat = (uint)(o0.x + 0.5f);
            return true;
        }
    }
    return false;
}

/**
 * One planet voxel: FVoxelCPUNoiseGenerator::GenerateChunkSphericalPlanet's loop body.
 *
 * @param VoxelCoord Voxel index in the chunk
 * @param WorldPos Absolute voxel position (unread: every planet quantity is chunk-relative)
 * @param VoxelSize Base voxel size (generation ignores the LOD)
 */
void GeneratePlanetVoxel(uint3 VoxelCoord, float3 WorldPos, float VoxelSize,
    out uint OutDensity, out uint OutMaterialID, out uint OutBiomeID, out uint OutMetadata)
{
    OutBiomeID = 0u;
    OutMetadata = 0u;

    // The voxel in its chunk's frame (WM-BP5, WM-BP6): its altitude is the anchor's + the small difference of its distance
    // from the centre, its datum-sphere point the anchor's + SurfaceOffset; the noise fields sample their per-chunk origins
    // + the voxel's small offsets.
    const PlanetVoxelFrame Frame = MakePlanetVoxelFrame(VoxelCoord, VoxelSize);
    const float3 SurfaceOffset = PlanetRadius * Frame.DeltaDir;
    const float Altitude = PlanetAnchorAltitude + Frame.DeltaR;

    // The surface along this direction (SampleRadialDisplacement): terrain noise and continentalness on the datum
    // sphere, the displacement modulated by continentalness as in the heightmap modes (SP-B1, SP-B5).
    float EffectiveBaseHeight = BaseHeight;
    float EffectiveHeightScale = HeightScale;
    float Continentalness = 0.0f;
    if (ContinentalnessEnabled != 0)
    {
        Continentalness = GpuContinentalnessCurves(
            PlanetFBM3D(ContinentNoiseOrigin, SurfaceOffset, NOISE_TYPE_SIMPLEX, ContinentalnessSeed, 2, ContinentalnessFrequency, 1.0f, 2.0f, 0.5f),
            EffectiveBaseHeight, EffectiveHeightScale);
    }
    const float TerrainNoise = PlanetFBM3D(TerrainNoiseOrigin, SurfaceOffset,
        NoiseType, NoiseSeed, NoiseOctaves, NoiseFrequency, NoiseAmplitude, NoiseLacunarity, NoisePersistence);
    float TerrainAltitude = EffectiveBaseHeight + TerrainNoise * EffectiveHeightScale * 0.5f;

    // Terrain conditioning (SP-B10): the planet zones blend the altitude along this direction before the SDF, as on the CPU.
    if (ConditioningZoneCount > 0)
    {
        TerrainAltitude = PlanetApplyConditioning(SurfaceOffset, TerrainAltitude);
    }

    // The SDF and the depth from altitudes (ShellSignedDistanceAtAltitude, WM-BP4 / WM-BP6)
    uint Density = SignedDistanceToDensity(PlanetShellSignedDistance(Altitude, TerrainAltitude), VoxelSize);
    const float DepthBelowSurface = (TerrainAltitude - Altitude) / VoxelSize;

    // Height rules read the altitude above the datum (SP-B2); caves under the sea keep the underwater minimum depth (SP-B6).
    // The sea is an altitude too.
    const bool bUnderwaterColumn = (WaterLevelEnabled != 0) && (TerrainAltitude < PlanetWaterAltitude);

    const uint PreCaveDensity = Density;
    uint MaterialID;

    if (BiomeCount > 0)
    {
        // Temperature and moisture on the datum sphere, like the terrain (SP-B1)
        const float Temperature = PlanetFBM3D(TemperatureNoiseOrigin, SurfaceOffset, NOISE_TYPE_SIMPLEX, TemperatureSeed, 2, TemperatureFrequency, 1.0f, 2.0f, 0.5f);
        const float Moisture = PlanetFBM3D(MoistureNoiseOrigin, SurfaceOffset, NOISE_TYPE_SIMPLEX, MoistureSeed, 2, MoistureFrequency, 1.0f, 2.0f, 0.5f);
        const BiomeBlendResult Blend = SampleGpuBiomeBlend(Temperature, Moisture, Continentalness);
        const GpuBiome Dominant = LoadGpuBiome(Blend.Indices[0]);
        OutBiomeID = Dominant.BiomeID;

        // Caves need the biome (its cave scale and minimum-depth override), so they come after the blend, as on the CPU.
        float CaveCarve = 0.0f;
        if (CaveEnabled != 0 && Density >= 127u && DepthBelowSurface > 0.0f)
        {
            CaveCarve = GpuCaveCarve(WorldPos, Frame, DepthBelowSurface, OutBiomeID, bUnderwaterColumn, true);
            Density = ApplyCaveCarve(Density, CaveCarve);
        }

        // Underwater materials when the column's terrain is under the sea (GetBlendedMaterialWithWater by altitude)
        const bool bUnderwaterMaterial = (WaterLevelEnabled != 0) && (EnableUnderwaterMaterials != 0) && (TerrainAltitude < PlanetWaterAltitude);
        MaterialID = GpuBlendedMaterial(Blend, DepthBelowSurface, bUnderwaterMaterial, BlendDitherBase + int3(VoxelCoord));

        MaterialID = ApplyGpuHeightRules(MaterialID, Altitude, DepthBelowSurface);

        if (CaveWallOverrideEnabled != 0 && CaveCarve > 0.0f && CaveCarve < 1.0f
            && Density >= 127u && DepthBelowSurface >= CaveWallMaterialMinDepth)
        {
            MaterialID = CaveWallMaterialID;
        }

        // Ore veins (solid voxels well below the surface; depth > 10 as on the CPU): the planet ore noise (WM-BP5), the
        // Rarity hash on the planet-relative position rounded to whole uu (SP-H3): the chunk's integer base + the voxel's
        // offset (WM-BP6; a float position of size R would round to 8 uu)
        if (Density >= 127u && DepthBelowSurface > 10.0f)
        {
            uint OreMat;
            const int3 RarityKey = ChunkBaseInt + int3(floor(ChunkBaseFrac + float3(VoxelCoord) * VoxelSize + 0.5f));
            if (GpuCheckPlanetOreVein(Frame.D, RarityKey, DepthBelowSurface, Dominant.OreStart, Dominant.OreCount, NoiseSeed, OreMat))
            {
                MaterialID = OreMat;
            }
        }
    }
    else
    {
        MaterialID = GetMaterialForPlanet(DepthBelowSurface * VoxelSize);
        if (CaveEnabled != 0 && Density >= 127u && DepthBelowSurface > 0.0f)
        {
            Density = ApplyCaveCarve(Density, GpuCaveCarve(WorldPos, Frame, DepthBelowSurface, 0u, bUnderwaterColumn, true));
        }
    }

    // Cave and underground flags where carving turned solid into air (the water fill's barriers; cleared by its phase 3)
    if (PreCaveDensity >= 127u && Density < 127u)
    {
        OutMetadata = (VOXEL_FLAG_CAVE | VOXEL_FLAG_UNDERGROUND) << 4;
    }

    OutDensity = Density;
    OutMaterialID = MaterialID;
}
