//
// The valleys on the GPU (Documentation/VALLEYS_PLAN.md, section 6.2): the chunk's valley segments carved into the
// natural height, after the island's falloff and before the conditioning lines, in the heightmap branch
// (GenerateVoxelDensity.usf) and into a planet's altitude in its branch (SphericalPlanet.ush, the plan's V5). Mirrors VoxelValleyCarve (VoxelChunkValleySegments.h) operation for operation: the CPU
// generator evaluates the same float4s, so GPU and CPU match (VoxelWorlds.Generation.GPUvsCPUValleyParity). Any change
// here must be mirrored there.
//
// Include AFTER the generation globals: this file reads ValleySegmentCount, ValleyData and ValleySeaLevel.
//
// ValleyData is the chunk's segment list, 3 float4s a segment (VOXELGEN_VALLEY_SEGMENT_STRIDE,
// VoxelValleyCarve::SegmentStride), positions relative to the chunk's origin corner with every z 0 on a heightmap world,
// and on a planet points on the datum sphere less the anchor's datum point (the conditioning lines' frame):
//   [A.xyz, floor at A] [B.xyz, floor at B] [floor half width, valley half width, taper at A, taper at B]
// The distance is the chord. ValleySeaLevel is the sea's level, a planet's as an altitude.

#pragma once

#define VOXELGEN_VALLEY_SEGMENT_STRIDE 3

/**
 * The height with the valleys at a point of the chunk's frame: each segment's weight (1 on the floor, a smoothstep to 0
 * across the side, times the head's taper) and floor; the deepest cut plus the highest fill; ground under the sea left
 * as it is.
 *
 * @param Offset The point in the list's frame: from the chunk's origin corner with z 0, or a planet voxel's datum point
 *        less the anchor's (SurfaceOffset)
 * @param Natural The natural height (a planet: altitude) there
 * @return The height with the valleys
 */
float GpuApplyValleys(float3 Offset, float Natural)
{
    if (Natural < ValleySeaLevel)
    {
        return Natural;
    }
    float Cut = 0.0f;
    float Fill = 0.0f;
    for (int Segment = 0; Segment < ValleySegmentCount; ++Segment)
    {
        const float4 r0 = ValleyData[Segment * VOXELGEN_VALLEY_SEGMENT_STRIDE + 0];
        const float4 r1 = ValleyData[Segment * VOXELGEN_VALLEY_SEGMENT_STRIDE + 1];
        const float4 r2 = ValleyData[Segment * VOXELGEN_VALLEY_SEGMENT_STRIDE + 2];
        const float ABx = r1.x - r0.x;
        const float ABy = r1.y - r0.y;
        const float ABz = r1.z - r0.z;
        const float Length2 = ABx * ABx + ABy * ABy + ABz * ABz;
        const float T = Length2 > 0.0f ? clamp(((Offset.x - r0.x) * ABx + (Offset.y - r0.y) * ABy + (Offset.z - r0.z) * ABz) / Length2, 0.0f, 1.0f) : 0.0f;
        const float Dx = Offset.x - (r0.x + ABx * T);
        const float Dy = Offset.y - (r0.y + ABy * T);
        const float Dz = Offset.z - (r0.z + ABz * T);
        const float D = sqrt(Dx * Dx + Dy * Dy + Dz * Dz);
        if (D >= r2.y)
        {
            continue;
        }
        const float Floor = r0.w + (r1.w - r0.w) * T;
        const float U = clamp((D - r2.x) / max(1.0f, r2.y - r2.x), 0.0f, 1.0f);
        const float Weight = (1.0f - U * U * (3.0f - 2.0f * U)) * (r2.z + (r2.w - r2.z) * T);
        if (Weight > 0.0f)
        {
            const float Change = Weight * (Floor - Natural);
            Cut = min(Cut, Change);
            Fill = max(Fill, Change);
        }
    }
    return (Natural + Cut) + Fill;
}
