//
// The valleys on the GPU (Documentation/VALLEYS_PLAN.md, section 6.2): the chunk's valley segments carved into the
// natural height, after the island's falloff and before the conditioning lines, in the heightmap branch
// (GenerateVoxelDensity.usf). Mirrors VoxelValleyCarve (VoxelChunkValleySegments.h) operation for operation: the CPU
// generator evaluates the same float4s, so GPU and CPU match (VoxelWorlds.Generation.GPUvsCPUValleyParity). Any change
// here must be mirrored there.
//
// Include AFTER the generation globals: this file reads ValleySegmentCount, ValleyData and ValleySeaLevel.
//
// ValleyData is the chunk's segment list, 3 float4s a segment (VOXELGEN_VALLEY_SEGMENT_STRIDE,
// VoxelValleyCarve::SegmentStride), positions relative to the chunk's origin corner:
//   [A.x, A.y, B.x, B.y] [floor at A, floor at B, floor half width, valley half width] [taper at A, taper at B, 0, 0]

#pragma once

#define VOXELGEN_VALLEY_SEGMENT_STRIDE 3

/**
 * The height with the valleys at a point of the chunk's frame: each segment's weight (1 on the floor, a smoothstep to 0
 * across the side, times the head's taper) and floor; the deepest cut plus the highest fill; ground under the sea left
 * as it is.
 *
 * @param Offset2D The point, from the chunk's origin corner (z unused)
 * @param Natural The natural height there
 * @return The height with the valleys
 */
float GpuApplyValleys(float3 Offset2D, float Natural)
{
    if (Natural < ValleySeaLevel)
    {
        return Natural;
    }
    float Cut = 0.0f;
    float Fill = 0.0f;
    for (int Segment = 0; Segment < ValleySegmentCount; ++Segment)
    {
        const float4 r0 = ValleyData[Segment * VOXELGEN_VALLEY_SEGMENT_STRIDE + 0];
        const float4 r1 = ValleyData[Segment * VOXELGEN_VALLEY_SEGMENT_STRIDE + 1];
        const float4 r2 = ValleyData[Segment * VOXELGEN_VALLEY_SEGMENT_STRIDE + 2];
        const float ABx = r0.z - r0.x;
        const float ABy = r0.w - r0.y;
        const float Length2 = ABx * ABx + ABy * ABy;
        const float T = Length2 > 0.0f ? clamp(((Offset2D.x - r0.x) * ABx + (Offset2D.y - r0.y) * ABy) / Length2, 0.0f, 1.0f) : 0.0f;
        const float Dx = Offset2D.x - (r0.x + ABx * T);
        const float Dy = Offset2D.y - (r0.y + ABy * T);
        const float D = sqrt(Dx * Dx + Dy * Dy);
        if (D >= r1.w)
        {
            continue;
        }
        const float Floor = r1.x + (r1.y - r1.x) * T;
        const float U = clamp((D - r1.z) / max(1.0f, r1.w - r1.z), 0.0f, 1.0f);
        const float Weight = (1.0f - U * U * (3.0f - 2.0f * U)) * (r2.x + (r2.y - r2.x) * T);
        if (Weight > 0.0f)
        {
            const float Change = Weight * (Floor - Natural);
            Cut = min(Cut, Change);
            Fill = max(Fill, Change);
        }
    }
    return (Natural + Cut) + Fill;
}
