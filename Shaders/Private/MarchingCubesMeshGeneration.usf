/**
 * Compute shader for smooth (Marching Cubes) mesh generation.
 *
 * Generates smooth mesh geometry by interpolating vertex positions along cube
 * edges where the density field crosses the isosurface.
 *
 * This GPU path mirrors VoxelCPUMarchingCubesMesher.cpp:
 *   - MainCS runs regular Marching Cubes using Lengyel's REGULAR MC tables
 *     (ProcessCubeLOD), so the regular cells are table-compatible with the
 *     transition cells (the same reason the CPU mesher uses Lengyel tables).
 *   - TransitionCS emits the zero-thickness transvoxel reduction ribbon at LOD
 *     boundaries (ProcessTransitionCell), sealing fine<->coarse seams.
 *
 * Both passes write to the same output buffers via the same atomic counters
 * (triangle-soup: 3 fresh vertices per triangle, no index sharing).
 *
 * Thread Group Size: MainCS [8, 8, 4]; TransitionCS [8, 8, 1] (z = 6 faces)
 *
 * @see Plugins/VoxelWorlds/Documentation/LOD_SEAM_INVESTIGATION.md
 */

#include "/Engine/Public/Platform.ush"
#include "/Plugin/VoxelWorlds/Private/MarchingCubesCommon.ush"
#include "/Plugin/VoxelWorlds/Private/TransvoxelCommon.ush"

// ==================== Shader Parameters ====================

// Input: Packed voxel data (ChunkSize^3 elements)
StructuredBuffer<uint> InputVoxelData;

// Face neighbor chunk data for seamless boundaries (6 faces)
StructuredBuffer<uint> NeighborXPos;
StructuredBuffer<uint> NeighborXNeg;
StructuredBuffer<uint> NeighborYPos;
StructuredBuffer<uint> NeighborYNeg;
StructuredBuffer<uint> NeighborZPos;
StructuredBuffer<uint> NeighborZNeg;

// Edge neighbor data for diagonal chunk boundaries (12 edges)
StructuredBuffer<uint> EdgeXPosYPos;
StructuredBuffer<uint> EdgeXPosYNeg;
StructuredBuffer<uint> EdgeXNegYPos;
StructuredBuffer<uint> EdgeXNegYNeg;
StructuredBuffer<uint> EdgeXPosZPos;
StructuredBuffer<uint> EdgeXPosZNeg;
StructuredBuffer<uint> EdgeXNegZPos;
StructuredBuffer<uint> EdgeXNegZNeg;
StructuredBuffer<uint> EdgeYPosZPos;
StructuredBuffer<uint> EdgeYPosZNeg;
StructuredBuffer<uint> EdgeYNegZPos;
StructuredBuffer<uint> EdgeYNegZNeg;

// Corner neighbor data (8 corners)
StructuredBuffer<uint> CornerData;

// Face neighbor presence flags (bits 0-5)
uint NeighborFlags;

// Edge/corner presence flags (bits 0-11 for edges, 12-19 for corners)
uint EdgeCornerFlags;

// Edge flag bit positions
#define EDGE_XPOS_YPOS (1u << 0)
#define EDGE_XPOS_YNEG (1u << 1)
#define EDGE_XNEG_YPOS (1u << 2)
#define EDGE_XNEG_YNEG (1u << 3)
#define EDGE_XPOS_ZPOS (1u << 4)
#define EDGE_XPOS_ZNEG (1u << 5)
#define EDGE_XNEG_ZPOS (1u << 6)
#define EDGE_XNEG_ZNEG (1u << 7)
#define EDGE_YPOS_ZPOS (1u << 8)
#define EDGE_YPOS_ZNEG (1u << 9)
#define EDGE_YNEG_ZPOS (1u << 10)
#define EDGE_YNEG_ZNEG (1u << 11)

// Corner flag bit positions
#define CORNER_XPOS_YPOS_ZPOS (1u << 12)
#define CORNER_XPOS_YPOS_ZNEG (1u << 13)
#define CORNER_XPOS_YNEG_ZPOS (1u << 14)
#define CORNER_XPOS_YNEG_ZNEG (1u << 15)
#define CORNER_XNEG_YPOS_ZPOS (1u << 16)
#define CORNER_XNEG_YPOS_ZNEG (1u << 17)
#define CORNER_XNEG_YNEG_ZPOS (1u << 18)
#define CORNER_XNEG_YNEG_ZNEG (1u << 19)

// Transvoxel transition state (mirrors FVoxelMeshingRequest)
// Bit per face that borders a COARSER neighbor: 0:-X 1:+X 2:-Y 3:+Y 4:-Z 5:+Z
uint TransitionFaces;
// Per-face coarse cell size (2^neighborLOD) when that face transitions, else 0.
StructuredBuffer<uint> CoarserStrideBuf;

// Output buffers
RWStructuredBuffer<FVoxelVertexGPU> OutputVertices;
RWStructuredBuffer<uint> OutputIndices;
RWStructuredBuffer<uint> MeshCounters;

// Chunk parameters
uint ChunkSize;
float VoxelSize;
float3 ChunkWorldPosition;   // the chunk origin in the mesher's frame: zero since WM-BP7 (chunk-local positions)
float IsoLevel;
uint LODStride;  // 2^LODLevel (1, 2, 4, 8...)

// LOD-seam geomorph (mirrors VoxelCPUMarchingCubesMesher; voxel.MCBoundaryMorphWidth).
uint MCBoundaryMorph;        // 1 = ramp the fine surface to the coarse height near transition faces
float MCBoundaryMorphWidth;  // ramp width in coarse cells

// Vertex normals at stride > 1 (G61; voxel.Mesh.VoxelShadingNormals): 1 = LOD 0's normal at the voxel crossing on the
// vertex's edge (FindEdgeShadingPoint), 0 = the stride-scale gradient at the vertex, as before.
uint VoxelShadingNormals;

// Shading normals at voxel resolution (G62; voxel.Mesh.CrossingGradientNormals): 1 = the density gradient fitted to the
// voxels on the ramp around the point (TryFitShadingNormal), 0 = the central difference about the voxel it floors to.
uint CrossingGradientNormals;

// Edge crossings at stride > 1 (G80; voxel.Mesh.VoxelLODCrossings): 1 = a strided edge's vertex at the voxel crossing on
// it (FindEdgeShadingPoint), the geomorph toward the coarse cells' crossings (ComputeCoarseCrossingsZ); 0 = interpolated
// between the edge's two samples, as before.
uint VoxelLODCrossings;

// Output buffer capacities (overflow protection — mirrors the DC mesher). Cave-riddled chunks have far
// more interior surface than the fixed triangle-soup buffers hold; without this guard the atomic counters
// run past the buffer end, out-of-bounds writes are dropped, and in-bounds index slots end up referencing
// vertices past the clamped count -> the renderer discards the whole section (invisible-but-collidable chunk).
uint MaxVertexCount;
uint MaxIndexCount;

// ==================== Helper Functions ====================

/** Check if face neighbor data is available for a direction. */
bool HasNeighborData(uint Face)
{
    return (NeighborFlags & (1u << Face)) != 0;
}

/** Check if edge neighbor data is available. */
bool HasEdgeData(uint EdgeFlag)
{
    return (EdgeCornerFlags & EdgeFlag) != 0;
}

/** Check if corner neighbor data is available. */
bool HasCornerData(uint CornerFlag)
{
    return (EdgeCornerFlags & CornerFlag) != 0;
}

/**
 * Get packed voxel data at position, handling chunk boundaries.
 * Handles face neighbors (1 axis out), edge neighbors (2 axes out),
 * and corner neighbors (3 axes out); an absent neighbor reads the nearest voxel of this chunk.
 *
 * The neighbor is found by index (face 0-5, edge 0-11, corner 0-7 in the FACE_ / EDGE_ / CORNER_ order: each axis + before
 * -) and read with one [branch] switch. This function is inlined at every call, and FXC (the D3D11 SM5 compiler) took
 * minutes per inlined copy of the if-ladder over the 26 neighbor buffers it replaces (VISUAL_POLISH_PLAN.md, F2.13).
 */
uint GetVoxelAt(int3 Position)
{
    // Check if within chunk bounds
    if (all(Position >= 0) && all(Position < (int)ChunkSize))
    {
        uint Index = GetVoxelIndex(Position, ChunkSize);
        return InputVoxelData[Index];
    }

    // Determine which axes are out of bounds and in which direction (Side: 0 = +, 1 = -)
    bool bXPos = (Position.x >= (int)ChunkSize);
    bool bXNeg = (Position.x < 0);
    bool bYPos = (Position.y >= (int)ChunkSize);
    bool bYNeg = (Position.y < 0);
    bool bZPos = (Position.z >= (int)ChunkSize);
    bool bZNeg = (Position.z < 0);

    bool bOutX = bXPos || bXNeg;
    bool bOutY = bYPos || bYNeg;
    bool bOutZ = bZPos || bZNeg;
    uint OutCount = (bOutX ? 1u : 0u) + (bOutY ? 1u : 0u) + (bOutZ ? 1u : 0u);
    uint SideX = bXNeg ? 1u : 0u;
    uint SideY = bYNeg ? 1u : 0u;
    uint SideZ = bZNeg ? 1u : 0u;

    // Single-axis out of bounds: use face neighbor data
    if (OutCount == 1u)
    {
        uint Face = bOutX ? (FACE_X_POS + SideX) : (bOutY ? (FACE_Y_POS + SideY) : (FACE_Z_POS + SideZ));
        uint InIdx = bOutX ? ((uint)Position.y + (uint)Position.z * ChunkSize)
            : (bOutY ? ((uint)Position.x + (uint)Position.z * ChunkSize) : ((uint)Position.x + (uint)Position.y * ChunkSize));
        if (HasNeighborData(Face))
        {
            [branch]
            switch (Face)
            {
                case FACE_X_POS: return NeighborXPos[InIdx];
                case FACE_X_NEG: return NeighborXNeg[InIdx];
                case FACE_Y_POS: return NeighborYPos[InIdx];
                case FACE_Y_NEG: return NeighborYNeg[InIdx];
                case FACE_Z_POS: return NeighborZPos[InIdx];
                default:         return NeighborZNeg[InIdx];
            }
        }
    }
    // Edge case (2 axes out of bounds): use edge neighbor data. X+Y edges (Z varies) 0-3, X+Z (Y varies) 4-7,
    // Y+Z (X varies) 8-11.
    else if (OutCount == 2u)
    {
        uint Edge;
        uint Free;
        if (!bOutZ)
        {
            Edge = SideX * 2u + SideY;
            Free = (uint)Position.z;
        }
        else if (!bOutY)
        {
            Edge = 4u + SideX * 2u + SideZ;
            Free = (uint)Position.y;
        }
        else
        {
            Edge = 8u + SideY * 2u + SideZ;
            Free = (uint)Position.x;
        }
        if (HasEdgeData(1u << Edge))
        {
            [branch]
            switch (Edge)
            {
                case 0u:  return EdgeXPosYPos[Free];
                case 1u:  return EdgeXPosYNeg[Free];
                case 2u:  return EdgeXNegYPos[Free];
                case 3u:  return EdgeXNegYNeg[Free];
                case 4u:  return EdgeXPosZPos[Free];
                case 5u:  return EdgeXPosZNeg[Free];
                case 6u:  return EdgeXNegZPos[Free];
                case 7u:  return EdgeXNegZNeg[Free];
                case 8u:  return EdgeYPosZPos[Free];
                case 9u:  return EdgeYPosZNeg[Free];
                case 10u: return EdgeYNegZPos[Free];
                default:  return EdgeYNegZNeg[Free];
            }
        }
    }
    // Corner case (3 axes out of bounds): use corner neighbor data.
    // Corner indices in CornerData buffer:
    // 0: X+Y+Z+, 1: X+Y+Z-, 2: X+Y-Z+, 3: X+Y-Z-
    // 4: X-Y+Z+, 5: X-Y+Z-, 6: X-Y-Z+, 7: X-Y-Z-
    else
    {
        uint Corner = SideX * 4u + SideY * 2u + SideZ;
        if (HasCornerData(CORNER_XPOS_YPOS_ZPOS << Corner))
        {
            return CornerData[Corner];
        }
    }

    // Fallback to the nearest voxel of this chunk
    int3 ClampedPos = clamp(Position, int3(0, 0, 0), int3((int)ChunkSize - 1, (int)ChunkSize - 1, (int)ChunkSize - 1));
    return InputVoxelData[GetVoxelIndex(ClampedPos, ChunkSize)];
}

/** Get density at position (normalized 0-1). */
float GetDensityAt(int3 Position)
{
    uint PackedVoxel = GetVoxelAt(Position);
    return GetDensity(PackedVoxel);
}

/**
 * Calculate gradient-based normal with LOD-aware sampling. The six taps run in a [loop] so GetVoxelAt
 * is inlined once here: FXC (the D3D11 SM5 compiler) spends minutes to hours on every extra inlined
 * copy of it (VISUAL_POLISH_PLAN.md, F2.13), so the voxel reads in this file sit in loops.
 */
float3 CalculateGradientNormalLOD(int3 Position, int Stride)
{
    float3 G = float3(0, 0, 0);
    [loop]
    for (int Tap = 0; Tap < 6; Tap++)
    {
        int3 Dir = int3(Tap < 2 ? 1 : 0, (Tap >> 1) == 1 ? 1 : 0, Tap >= 4 ? 1 : 0);
        bool bNegative = (Tap & 1) != 0;
        float D = GetDensityAt(Position + Dir * (bNegative ? -Stride : Stride));
        G += float3(Dir) * (bNegative ? -D : D);
    }

    float3 Normal = -G;

    float Len = length(Normal);
    if (Len > 0.0001f)
    {
        return Normal / Len;
    }
    return float3(0, 0, 1);
}

/**
 * G62: whether GetVoxelAt returns the real voxel rather than a clamped stand-in, mirroring
 * FVoxelCPUMarchingCubesMesher::IsVoxelHeld: inside the chunk, or one voxel past it where that face's plane, edge's strip
 * or corner is bound.
 */
bool IsVoxelHeld(int3 P)
{
    int CS = (int)ChunkSize;
    if (any(P < int3(-1, -1, -1)) || any(P > int3(CS, CS, CS)))
    {
        return false;
    }
    bool bXPos = (P.x == CS);
    bool bXNeg = (P.x < 0);
    bool bYPos = (P.y == CS);
    bool bYNeg = (P.y < 0);
    bool bZPos = (P.z == CS);
    bool bZNeg = (P.z < 0);
    bool bOutX = bXPos || bXNeg;
    bool bOutY = bYPos || bYNeg;
    bool bOutZ = bZPos || bZNeg;
    uint OutCount = (bOutX ? 1u : 0u) + (bOutY ? 1u : 0u) + (bOutZ ? 1u : 0u);
    if (OutCount == 0u)
    {
        return true;
    }
    if (OutCount == 1u)
    {
        uint Face = bXPos ? FACE_X_POS : (bXNeg ? FACE_X_NEG : (bYPos ? FACE_Y_POS : (bYNeg ? FACE_Y_NEG : (bZPos ? FACE_Z_POS : FACE_Z_NEG))));
        return HasNeighborData(Face);
    }
    if (OutCount == 2u)
    {
        uint Edge;
        if (!bOutZ)
        {
            Edge = bXPos ? (bYPos ? EDGE_XPOS_YPOS : EDGE_XPOS_YNEG) : (bYPos ? EDGE_XNEG_YPOS : EDGE_XNEG_YNEG);
        }
        else if (!bOutY)
        {
            Edge = bXPos ? (bZPos ? EDGE_XPOS_ZPOS : EDGE_XPOS_ZNEG) : (bZPos ? EDGE_XNEG_ZPOS : EDGE_XNEG_ZNEG);
        }
        else
        {
            Edge = bYPos ? (bZPos ? EDGE_YPOS_ZPOS : EDGE_YPOS_ZNEG) : (bZPos ? EDGE_YNEG_ZPOS : EDGE_YNEG_ZNEG);
        }
        return HasEdgeData(Edge);
    }
    uint Corner = bXPos
        ? (bYPos ? (bZPos ? CORNER_XPOS_YPOS_ZPOS : CORNER_XPOS_YPOS_ZNEG) : (bZPos ? CORNER_XPOS_YNEG_ZPOS : CORNER_XPOS_YNEG_ZNEG))
        : (bYPos ? (bZPos ? CORNER_XNEG_YPOS_ZPOS : CORNER_XNEG_YPOS_ZNEG) : (bZPos ? CORNER_XNEG_YNEG_ZPOS : CORNER_XNEG_YNEG_ZNEG));
    return HasCornerData(Corner);
}

/**
 * G62: the shading normal at a point at voxel resolution, mirroring FVoxelCPUMarchingCubesMesher::CalculateShadingNormal
 * (VoxelCrossingGradient::FitNormal): the weighted least-squares fit of a linear density to the voxels of the 3x3x3 block
 * around the point's nearest voxel that lie on the ramp (0 < density < 1) and are held, tent weights centred on the point,
 * a free offset; where the voxels on the ramp do not span three directions (or CrossingGradientNormals is 0), the central
 * difference about the voxel the point floors to, as before. This is the fit: it returns false for that fallback, which
 * the caller takes (CalculateVertexNormal), so the gradient's voxel reads are inlined once (F2.13).
 */
bool TryFitShadingNormal(float3 P, out float3 OutNormal)
{
    OutNormal = float3(0.0f, 0.0f, 1.0f);
    if (CrossingGradientNormals != 0u)
    {
        int3 Base = (int3)floor(P + 0.5f) - int3(1, 1, 1);
        float SW = 0.0f;
        float SD = 0.0f;
        float3 SO = float3(0.0f, 0.0f, 0.0f);
        float XX = 0.0f, XY = 0.0f, XZ = 0.0f, YY = 0.0f, YZ = 0.0f, ZZ = 0.0f;
        float3 DO = float3(0.0f, 0.0f, 0.0f);
        [loop]
        for (int K = 0; K < 3; K++)
        {
            int VZ = Base.z + K;
            float OZ = (float)VZ - P.z;
            float WZ = 1.5f - abs(OZ);
            if (WZ <= 0.0f)
            {
                continue;
            }
            [loop]
            for (int J = 0; J < 3; J++)
            {
                int VY = Base.y + J;
                float OY = (float)VY - P.y;
                float WY = 1.5f - abs(OY);
                if (WY <= 0.0f)
                {
                    continue;
                }
                [loop]
                for (int I = 0; I < 3; I++)
                {
                    int VX = Base.x + I;
                    float OX = (float)VX - P.x;
                    float WX = 1.5f - abs(OX);
                    if (WX <= 0.0f || !IsVoxelHeld(int3(VX, VY, VZ)))
                    {
                        continue;
                    }
                    float D = GetDensityAt(int3(VX, VY, VZ));
                    if (D <= 0.0f || D >= 1.0f)
                    {
                        continue;
                    }
                    float W = WX * WY * WZ;
                    SW += W;
                    SD += W * D;
                    SO += W * float3(OX, OY, OZ);
                    XX += W * OX * OX;
                    XY += W * OX * OY;
                    XZ += W * OX * OZ;
                    YY += W * OY * OY;
                    YZ += W * OY * OZ;
                    ZZ += W * OZ * OZ;
                    DO += W * D * float3(OX, OY, OZ);
                }
            }
        }
        if (SW > 0.0f)
        {
            float InvW = 1.0f / SW;
            float M00 = XX - SO.x * SO.x * InvW, M01 = XY - SO.x * SO.y * InvW, M02 = XZ - SO.x * SO.z * InvW;
            float M11 = YY - SO.y * SO.y * InvW, M12 = YZ - SO.y * SO.z * InvW, M22 = ZZ - SO.z * SO.z * InvW;
            float3 R = DO - SD * SO * InvW;
            float C00 = M11 * M22 - M12 * M12;
            float C01 = M02 * M12 - M01 * M22;
            float C02 = M01 * M12 - M02 * M11;
            float C11 = M00 * M22 - M02 * M02;
            float C12 = M01 * M02 - M00 * M12;
            float C22 = M00 * M11 - M01 * M01;
            float Det = M00 * C00 + M01 * C01 + M02 * C02;
            float Third = (M00 + M11 + M22) / 3.0f;
            if (Third > 0.0f && Det > 0.02f * Third * Third * Third)
            {
                float3 N = -float3(C00 * R.x + C01 * R.y + C02 * R.z, C01 * R.x + C11 * R.y + C12 * R.z, C02 * R.x + C12 * R.y + C22 * R.z);
                float LenSq = dot(N, N);
                if (LenSq > 1e-8f)
                {
                    OutNormal = N * rsqrt(LenSq);
                    return true;
                }
            }
        }
    }
    return false;
}

/** voxel.Mesh.VoxelShadingNormals for a vertex of this stride (G61; LOD 0, stride 1, is the reference). */
bool UseVoxelShadingNormals(int Stride)
{
    return VoxelShadingNormals != 0u && Stride > 1;
}

/** voxel.Mesh.VoxelLODCrossings for an edge this many voxels long (G80; a one-voxel edge keeps InterpolateEdge's vertex). */
bool UseVoxelLODCrossings(int EdgeLength)
{
    return VoxelLODCrossings != 0u && EdgeLength > 1;
}

/**
 * G61: where an edge vertex at stride > 1 takes its normal, mirroring FVoxelCPUMarchingCubesMesher::CalculateEdgeShadingNormal.
 * The generated density saturates a voxel either side of the surface, so the stride-scale gradient's taps read 0 or 255 and
 * its normal snaps toward the cube directions; the normal is LOD 0's (taps one voxel apart) at the voxel crossing on the
 * edge nearest the vertex, the edge walked from its min end so every cell sharing it agrees. Returns false for an edge
 * that is not axis-aligned or has no voxel crossing (none reaches here): the caller takes the stride-scale gradient.
 */
bool FindEdgeShadingPoint(int3 EndA, int3 EndB, float DensityA, float DensityB, out float3 OutCrossing)
{
    int3 Delta = EndB - EndA;
    int OffAxes = (Delta.x != 0 ? 1 : 0) + (Delta.y != 0 ? 1 : 0) + (Delta.z != 0 ? 1 : 0);
    int3 Dir = int3(Delta.x != 0 ? 1 : 0, (Delta.x == 0 && Delta.y != 0) ? 1 : 0, (Delta.x == 0 && Delta.y == 0) ? 1 : 0);
    int Along0 = dot(Delta, Dir);
    int Length = abs(Along0);

    float BestAlong = -1.0f;
    bool bAFirst = Along0 > 0;
    int3 Lo = bAFirst ? EndA : EndB;
    if (Length != 0 && OffAxes == 1)
    {
        float DLo = bAFirst ? DensityA : DensityB;
        float DHi = bAFirst ? DensityB : DensityA;

        // The vertex's place on the edge (voxels from Lo), as InterpolateEdge puts it.
        float VertexT = (abs(DHi - DLo) < 0.00001f) ? 0.5f : saturate((IsoLevel - DLo) / (DHi - DLo));
        float VertexAlong = VertexT * (float)Length;

        float D0 = DLo;
        float BestDist = 1e30f;
        [loop]
        for (int Step = 0; Step < Length; Step++)
        {
            float D1 = (Step + 1 == Length) ? DHi : GetDensityAt(Lo + Dir * (Step + 1));
            if ((D0 >= IsoLevel) != (D1 >= IsoLevel))
            {
                float T = saturate((IsoLevel - D0) / (D1 - D0));
                float Along = (float)Step + T;
                float Dist = abs(Along - VertexAlong);
                if (Dist < BestDist)
                {
                    BestDist = Dist;
                    BestAlong = Along;
                }
            }
            D0 = D1;
        }
    }
    OutCrossing = (float3)Lo + (float3)Dir * max(BestAlong, 0.0f);
    return BestAlong >= 0.0f;
}

/**
 * A vertex's normal (G61, G62). At a stride > 1 with voxel.Mesh.VoxelShadingNormals: the fitted normal at the voxel crossing
 * on the vertex's edge (FindEdgeShadingPoint's, found by the caller), the stride-scale gradient at the vertex where the edge
 * has none; at stride 1: the fitted normal at the vertex; otherwise the stride-scale gradient at the vertex. A fit that
 * falls back takes the central difference about the voxel its point floors to. One inlined copy each of the fit and the
 * gradient, for both passes; each pass walks its edges in one loop of its own (F2.13).
 *
 * @param VertexVoxelPos The vertex in voxel units of the chunk (its world position less ChunkWorldPosition, / VoxelSize)
 * @param Stride The stride of the mesh the vertex belongs to
 * @param bHasCrossing Whether the vertex's edge has a voxel crossing (FindEdgeShadingPoint's result)
 * @param Crossing That crossing (voxels)
 */
float3 CalculateVertexNormal(float3 VertexVoxelPos, int Stride, bool bHasCrossing, float3 Crossing)
{
    int3 GradientPos = (int3)VertexVoxelPos;
    int GradientStride = Stride;
    float3 FitPoint = VertexVoxelPos;
    bool bFit = (Stride == 1);
    if (UseVoxelShadingNormals(Stride))
    {
        bFit = bHasCrossing;
        FitPoint = Crossing;
    }
    if (bFit)
    {
        float3 Fitted;
        if (TryFitShadingNormal(FitPoint, Fitted))
        {
            return Fitted;
        }
        GradientPos = (int3)floor(FitPoint);
        GradientStride = 1;
    }
    return CalculateGradientNormalLOD(GradientPos, GradientStride);
}

/**
 * The first solid corner's voxel, in Lengyel corner order, whose material and biome the cell takes;
 * 0 (material 0, biome 0) when no corner is solid. SolidMask has bit i set when corner i
 * (LengyelCornerOffsets[i]) is solid. One read (F2.13).
 */
uint GetDominantVoxelLengyel(int3 CubePos, uint SolidMask, int Stride)
{
    if (SolidMask == 0u)
    {
        return 0;
    }
    int3 CornerPos = CubePos + LengyelCornerOffsets[firstbitlow(SolidMask)] * Stride;
    return GetVoxelAt(CornerPos);
}

/**
 * Dominant-axis (triplanar-style) UV projection for a triangle. World-space
 * positions; matches the regular pass so the ribbon textures consistently.
 */
void ComputeTriangleUVs(float3 P0, float3 P1, float3 P2, out float2 UV0, out float2 UV1, out float2 UV2)
{
    float3 FaceNormal = normalize(cross(P1 - P0, P2 - P0));
    float AbsX = abs(FaceNormal.x);
    float AbsY = abs(FaceNormal.y);
    float AbsZ = abs(FaceNormal.z);

    const float UVScale = 0.1f;
    if (AbsZ >= AbsX && AbsZ >= AbsY)
    {
        UV0 = P0.xy / VoxelSize * UVScale;
        UV1 = P1.xy / VoxelSize * UVScale;
        UV2 = P2.xy / VoxelSize * UVScale;
    }
    else if (AbsX >= AbsY)
    {
        UV0 = P0.yz / VoxelSize * UVScale;
        UV1 = P1.yz / VoxelSize * UVScale;
        UV2 = P2.yz / VoxelSize * UVScale;
    }
    else
    {
        UV0 = P0.xz / VoxelSize * UVScale;
        UV1 = P1.xz / VoxelSize * UVScale;
        UV2 = P2.xz / VoxelSize * UVScale;
    }
}

// ==================== LOD-seam geomorph (mirrors the CPU mesher) ====================

/** Trilinear density at a fractional voxel position (for the steepness gradient). */
float GetDensityAtFloat(float3 P)
{
    int3 P0 = (int3)floor(P);
    float3 F = P - (float3)P0;
    // D[x + 2y + 4z]: the 8 corners read in one [loop] (F2.13).
    float D[8];
    [loop]
    for (int Corner = 0; Corner < 8; Corner++)
    {
        D[Corner] = GetDensityAt(P0 + int3(Corner & 1, (Corner >> 1) & 1, Corner >> 2));
    }
    float d00 = lerp(D[0], D[1], F.x);
    float d10 = lerp(D[2], D[3], F.x);
    float d01 = lerp(D[4], D[5], F.x);
    float d11 = lerp(D[6], D[7], F.x);
    return lerp(lerp(d00, d10, F.y), lerp(d01, d11, F.y), F.z);
}

/**
 * Height (voxel units) where the coarse-LOD iso-surface crosses the column at (Vx,Vy),
 * nearest NearVz. Face-parallel samples clamped to [0,ChunkSize] (neighbour data is one plane
 * deep). Za/Zb are coarse-aligned, so each level is a bilinear XY sample. Returns false if no
 * crossing is found in the search band.
 */
bool ComputeCoarseSurfaceZ(float Vx, float Vy, float NearVz, uint Eu, out float OutVz)
{
    OutVz = NearVz;
    int E = (int)Eu;
    float Ef = (float)E;
    int CS = (int)ChunkSize;

    int X0 = (int)floor(Vx / Ef) * E;
    int Y0 = (int)floor(Vy / Ef) * E;
    float Fx = (Vx - (float)X0) / Ef;
    float Fy = (Vy - (float)Y0) / Ef;
    int Xa = clamp(X0,     0, CS);
    int Xb = clamp(X0 + E, 0, CS);
    int Ya = clamp(Y0,     0, CS);
    int Yb = clamp(Y0 + E, 0, CS);

    int ZBase = (int)floor(NearVz / Ef) * E;
    float BestDist = 1e30f;
    bool bFound = false;
    [loop]
    for (int k = -4; k < 4; k++)
    {
        int Zai = ZBase + k * E;
        int Zbi = Zai + E;
        // S[x + 2y + 4z] over (Xa|Xb, Ya|Yb, Zai|Zbi), read in one [loop] (F2.13).
        float S[8];
        [loop]
        for (int Sample = 0; Sample < 8; Sample++)
        {
            S[Sample] = GetDensityAt(int3((Sample & 1) != 0 ? Xb : Xa, (Sample & 2) != 0 ? Yb : Ya, (Sample & 4) != 0 ? Zbi : Zai));
        }
        float Da = lerp(lerp(S[0], S[1], Fx), lerp(S[2], S[3], Fx), Fy);
        float Db = lerp(lerp(S[4], S[5], Fx), lerp(S[6], S[7], Fx), Fy);
        if ((Da >= IsoLevel) != (Db >= IsoLevel))
        {
            float Denom = Db - Da;
            float T = (abs(Denom) < 1e-5f) ? 0.5f : saturate((IsoLevel - Da) / Denom);
            float Zc = (float)Zai + T * Ef;
            float Dist = abs(Zc - NearVz);
            if (Dist < BestDist)
            {
                BestDist = Dist;
                OutVz = Zc;
                bFound = true;
            }
        }
    }
    return bFound;
}

/**
 * ComputeCoarseSurfaceZ with voxel.Mesh.VoxelLODCrossings (G80), mirroring the CPU mesher's
 * ComputeCoarseCrossingsAlongAxis along Z: the coarse cells' vertices on the four coarse edge columns around (Vx,Vy)
 * (the same clamp and search band), each the voxel crossing nearest NearVz, blended bilinearly. Returns false if a
 * column with a share of the blend has none.
 */
bool ComputeCoarseCrossingsZ(float Vx, float Vy, float NearVz, uint Eu, out float OutVz)
{
    OutVz = NearVz;
    int E = (int)Eu;
    float Ef = (float)E;
    int CS = (int)ChunkSize;

    int X0 = (int)floor(Vx / Ef) * E;
    int Y0 = (int)floor(Vy / Ef) * E;
    float Fx = (Vx - (float)X0) / Ef;
    float Fy = (Vy - (float)Y0) / Ef;
    int ZBase = (int)floor(NearVz / Ef) * E;

    float Sum = 0.0f;
    bool bAll = true;
    [loop]
    for (int Column = 0; Column < 4; Column++)
    {
        float Weight = (((Column & 1) != 0) ? Fx : 1.0f - Fx) * (((Column & 2) != 0) ? Fy : 1.0f - Fy);
        if (Weight <= 0.0f)
        {
            continue;
        }
        int CX = clamp(X0 + (((Column & 1) != 0) ? E : 0), 0, CS);
        int CY = clamp(Y0 + (((Column & 2) != 0) ? E : 0), 0, CS);
        float BestDist = 1e30f;
        float Best = 0.0f;
        bool bFound = false;
        [loop]
        for (int k = -4; k < 4; k++)
        {
            int3 EndA = int3(CX, CY, ZBase + k * E);
            int3 EndB = int3(CX, CY, ZBase + k * E + E);
            float Da = GetDensityAt(EndA);
            float Db = GetDensityAt(EndB);
            float3 Crossing;
            if ((Da >= IsoLevel) != (Db >= IsoLevel) && FindEdgeShadingPoint(EndA, EndB, Da, Db, Crossing))
            {
                float Dist = abs(Crossing.z - NearVz);
                if (Dist < BestDist)
                {
                    BestDist = Dist;
                    Best = Crossing.z;
                    bFound = true;
                }
            }
        }
        if (!bFound)
        {
            bAll = false;
            break;
        }
        Sum += Weight * Best;
    }
    if (bAll)
    {
        OutVz = Sum;
    }
    return bAll;
}

/**
 * Geomorph one (world-space) vertex toward the coarse-LOD surface. Mask = active transition
 * faces to ramp against. Skips steep (non-height-function) surfaces. Pure function of position,
 * so coincident fine-MC / ribbon vertices morph identically and stay watertight.
 */
void MorphVertexToCoarse(uint SelfStride, uint Mask, inout float3 Vertex)
{
    float Vx = (Vertex.x - ChunkWorldPosition.x) / VoxelSize;
    float Vy = (Vertex.y - ChunkWorldPosition.y) / VoxelSize;
    float Vz = (Vertex.z - ChunkWorldPosition.z) / VoxelSize;

    float MorphWidth = max(0.01f, MCBoundaryMorphWidth);

    float BestW = 0.0f;
    uint BestE = SelfStride;
    [unroll]
    for (uint Face = 0; Face < 6u; Face++)
    {
        if ((Mask & (1u << Face)) == 0u) { continue; }
        uint E = CoarserStrideBuf[Face];
        if (E <= SelfStride) { continue; }
        uint Axis = Face / 2u;
        bool bPositive = (Face & 1u) != 0u;
        float BoundaryCoord = bPositive ? (float)ChunkSize : 0.0f;
        float VCoord = (Axis == 0u) ? Vx : ((Axis == 1u) ? Vy : Vz);
        float DistCells = abs(VCoord - BoundaryCoord) / (float)E;
        float W = saturate((MorphWidth - DistCells) / MorphWidth);
        if (W > BestW) { BestW = W; BestE = E; }
    }
    if (BestW <= 0.0f) { return; }

    // Steepness gate: only morph where the surface normal (-grad density) is mostly vertical. The six
    // taps run in one [loop] (F2.13).
    float3 G = float3(0.0f, 0.0f, 0.0f);
    [loop]
    for (int Tap = 0; Tap < 6; Tap++)
    {
        float3 Dir = float3(Tap < 2 ? 1.0f : 0.0f, (Tap >> 1) == 1 ? 1.0f : 0.0f, Tap >= 4 ? 1.0f : 0.0f);
        bool bNegative = (Tap & 1) != 0;
        float D = GetDensityAtFloat(float3(Vx, Vy, Vz) + Dir * (bNegative ? -1.0f : 1.0f));
        G += Dir * (bNegative ? -D : D);
    }
    float Gx = G.x;
    float Gy = G.y;
    float Gz = G.z;
    float GMag = sqrt(Gx * Gx + Gy * Gy + Gz * Gz);
    if (GMag < 1e-5f || abs(Gz) < 0.5f * GMag) { return; }

    // if/else, not ?: (which evaluates both calls, each writing SecVz, before HLSL 2021).
    float SecVz;
    bool bFound;
    if (UseVoxelLODCrossings((int)BestE))
    {
        bFound = ComputeCoarseCrossingsZ(Vx, Vy, Vz, BestE, SecVz);
    }
    else
    {
        bFound = ComputeCoarseSurfaceZ(Vx, Vy, Vz, BestE, SecVz);
    }
    if (bFound)
    {
        float MorphedVz = lerp(Vz, SecVz, BestW);
        Vertex.z = ChunkWorldPosition.z + MorphedVz * VoxelSize;
    }
}

// ==================== Main Compute Shader (Regular MC, Lengyel tables) ====================

[numthreads(8, 8, 4)]
void MainCS(
    uint3 GroupId : SV_GroupID,
    uint3 GroupThreadId : SV_GroupThreadID,
    uint3 DispatchThreadId : SV_DispatchThreadID)
{
    int Stride = (int)LODStride;

    // Each thread handles one LOD cube at strided intervals
    int3 CubePos = (int3)DispatchThreadId * Stride;

    // Early out if outside chunk bounds
    if (any(CubePos >= (int)ChunkSize))
    {
        return;
    }

    // Sample density + world position at the 8 cube corners (Lengyel ordering). [loop]: one inlined
    // GetVoxelAt (F2.13).
    float CornerDensities[8];
    float3 CornerPositions[8];
    [loop]
    for (uint i = 0; i < 8; i++)
    {
        int3 CornerPos = CubePos + LengyelCornerOffsets[i] * Stride;
        CornerDensities[i] = GetDensityAt(CornerPos);
        CornerPositions[i] = ChunkWorldPosition + float3(CornerPos) * VoxelSize;
    }

    // Build solid mask (bit set = corner inside), then Lengyel case index
    // (Lengyel tables use opposite polarity: bit set = OUTSIDE).
    uint SolidMask = 0;
    [unroll]
    for (uint i = 0; i < 8; i++)
    {
        if (CornerDensities[i] >= IsoLevel)
        {
            SolidMask |= (1u << i);
        }
    }
    uint CaseIndex = (~SolidMask) & 0xFFu;

    uint CellClass = Tv_RegularCellClass(CaseIndex);
    uint GeomCounts = Tv_RegularGeometryCounts(CellClass);
    uint VertexCount = GeomCounts >> 4;
    uint TriCount = GeomCounts & 0x0Fu;

    // Early out if no geometry (fully inside or fully outside)
    if (TriCount == 0)
    {
        return;
    }

    uint DominantVoxel = GetDominantVoxelLengyel(CubePos, SolidMask, Stride);
    uint MaterialID = GetMaterialID(DominantVoxel);
    uint BiomeID = GetBiomeID(DominantVoxel);

    // Decode edge vertices from RegularVertexData (low nibble = corner A, next = corner B)
    float3 CellVertices[12];
    uint VertexCorners[12];  // corner A | corner B << 4, for the vertex normals (G61)
    [unroll]
    for (uint i = 0; i < 12; i++)
    {
        if (i >= VertexCount)
        {
            break;
        }
        uint Code = Tv_RegularVertexData(CaseIndex, i);
        uint CornerA = Code & 0x0Fu;
        uint CornerB = (Code >> 4) & 0x0Fu;
        VertexCorners[i] = CornerA | (CornerB << 4);
        if (CornerA == CornerB)
        {
            CellVertices[i] = CornerPositions[CornerA];
        }
        else
        {
            CellVertices[i] = InterpolateEdge(
                CornerDensities[CornerA], CornerDensities[CornerB],
                CornerPositions[CornerA], CornerPositions[CornerB],
                IsoLevel);
        }
    }

    // The voxel crossing on each vertex's edge (G61's normal point; G80: the vertex itself at a stride), in one [loop]:
    // one inlined copy of the edge walk (F2.13).
    float3 CellCrossings[12];
    uint CrossingMask = 0u;
    if (UseVoxelShadingNormals(Stride) || UseVoxelLODCrossings(Stride))
    {
        [loop]
        for (uint ci = 0; ci < VertexCount; ci++)
        {
            uint CA = VertexCorners[ci] & 0x0Fu;
            uint CB = (VertexCorners[ci] >> 4) & 0x0Fu;
            float3 Crossing = float3(0.0f, 0.0f, 0.0f);
            if (CA != CB && FindEdgeShadingPoint(CubePos + LengyelCornerOffsets[CA] * Stride, CubePos + LengyelCornerOffsets[CB] * Stride,
                CornerDensities[CA], CornerDensities[CB], Crossing))
            {
                CrossingMask |= (1u << ci);
                if (UseVoxelLODCrossings(Stride))
                {
                    CellVertices[ci] = ChunkWorldPosition + Crossing * VoxelSize;
                }
            }
            CellCrossings[ci] = Crossing;
        }
    }

    // LOD-seam geomorph: ramp the fine boundary-slab vertices toward the coarse surface so the
    // LOD step collapses (no-op unless this cube borders a coarser neighbour). Mirrors the CPU
    // ApplyBoundaryMorph; the ribbon (TransitionCS) morphs its fine side the same way.
    if (MCBoundaryMorph != 0u && TransitionFaces != 0u)
    {
        [loop]
        for (uint mi = 0; mi < VertexCount; mi++)
        {
            MorphVertexToCoarse(LODStride, TransitionFaces, CellVertices[mi]);
        }
    }

    // Vertex normals. G61: at stride > 1, LOD 0's normal at the voxel crossing on the vertex's edge (a function of the
    // edge, so the geomorph does not change it); G62: at stride 1 the fitted gradient at the vertex; otherwise the
    // stride-scale gradient at the vertex, as before.
    float3 CellNormals[12];
    [loop]
    for (uint ni = 0; ni < VertexCount; ni++)
    {
        CellNormals[ni] = CalculateVertexNormal((CellVertices[ni] - ChunkWorldPosition) / VoxelSize, Stride,
            (CrossingMask & (1u << ni)) != 0u, CellCrossings[ni]);
    }

    // Atomically allocate vertices and indices
    uint VertexStart;
    uint IndexStart;
    InterlockedAdd(MeshCounters[0], TriCount * 3, VertexStart);
    InterlockedAdd(MeshCounters[1], TriCount * 3, IndexStart);

    // Overflow guard (mirrors the DC mesher): if this cube's geometry would exceed either output buffer,
    // emit nothing. The counters stay incremented (clamped on readback), but writing nothing means the
    // index buffer never references vertices past the buffer end -> no dangling indices, no dropped chunk.
    if (VertexStart + TriCount * 3u > MaxVertexCount || IndexStart + TriCount * 3u > MaxIndexCount)
    {
        return;
    }

    uint CurrentVertex = VertexStart;
    uint CurrentIndex = IndexStart;

    [loop]
    for (uint t = 0; t < TriCount; t++)
    {
        uint Idx0 = Tv_RegularVertexIndex(CellClass, t * 3 + 0);
        uint Idx1 = Tv_RegularVertexIndex(CellClass, t * 3 + 1);
        uint Idx2 = Tv_RegularVertexIndex(CellClass, t * 3 + 2);

        float3 P0 = CellVertices[Idx0];
        float3 P1 = CellVertices[Idx1];
        float3 P2 = CellVertices[Idx2];

        float3 N0 = CellNormals[Idx0];
        float3 N1 = CellNormals[Idx1];
        float3 N2 = CellNormals[Idx2];

        float2 UV0, UV1, UV2;
        ComputeTriangleUVs(P0, P1, P2, UV0, UV1, UV2);

        OutputVertices[CurrentVertex + 0] = CreateSmoothVertex(P0, N0, UV0, MaterialID, BiomeID);
        OutputVertices[CurrentVertex + 1] = CreateSmoothVertex(P1, N1, UV1, MaterialID, BiomeID);
        OutputVertices[CurrentVertex + 2] = CreateSmoothVertex(P2, N2, UV2, MaterialID, BiomeID);

        OutputIndices[CurrentIndex + 0] = CurrentVertex + 0;
        OutputIndices[CurrentIndex + 1] = CurrentVertex + 1;
        OutputIndices[CurrentIndex + 2] = CurrentVertex + 2;

        CurrentVertex += 3;
        CurrentIndex += 3;
    }
}

// ==================== Transition Cells (zero-thickness reduction ribbon) ====================
//
// Mirrors VoxelCPUMarchingCubesMesher::GetTransitionCellDensities +
// ProcessTransitionCell. For each active transition face and each coarse-aligned
// boundary position, emit a flat fine->coarse reduction ribbon IN the boundary
// plane (depth scale 0). The fine 9-sample face shares vertices with the finer
// chunk's regular MC (MainCS) on that plane; the 4 coarse corners (invariant
// d[9]=d[0], d[10]=d[2], d[11]=d[6], d[12]=d[8]) match the coarser neighbour.
//
// Dispatch: tid.x=FP1, tid.y=FP2, tid.z=Face (0..5).

[numthreads(8, 8, 1)]
void TransitionCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    uint Face = DispatchThreadId.z;
    if (Face >= 6u)
    {
        return;
    }
    if ((TransitionFaces & (1u << Face)) == 0u)
    {
        return;
    }

    uint CoarserStrideU = CoarserStrideBuf[Face];
    if (CoarserStrideU == 0u)
    {
        return;
    }
    int CoarserStride = (int)CoarserStrideU;

    int FP1 = (int)DispatchThreadId.x;
    int FP2 = (int)DispatchThreadId.y;
    if (FP1 >= (int)ChunkSize || FP2 >= (int)ChunkSize)
    {
        return;
    }
    // Only coarse-aligned boundary positions emit a ribbon
    if ((FP1 % CoarserStride) != 0 || (FP2 % CoarserStride) != 0)
    {
        return;
    }

    int CurrentStride = (int)LODStride;
    int DepthAxis = (int)(Face / 2u);
    bool bPositiveFace = (Face & 1u) != 0u;
    int BoundaryPos = bPositiveFace ? ((int)ChunkSize - CurrentStride) : 0;

    int CellX, CellY, CellZ;
    if (DepthAxis == 0) { CellX = BoundaryPos; CellY = FP1; CellZ = FP2; }
    else if (DepthAxis == 1) { CellX = FP1; CellY = BoundaryPos; CellZ = FP2; }
    else { CellX = FP1; CellY = FP2; CellZ = BoundaryPos; }

    // Depth axis pinned to the boundary plane; positive faces sit one chunk-stride out.
    int BaseDepthCoord = (DepthAxis == 0) ? CellX : (DepthAxis == 1) ? CellY : CellZ;
    int BoundaryDepthCoord = bPositiveFace ? (BaseDepthCoord + CurrentStride) : BaseDepthCoord;

    // ---- Sample 13 densities (zero-thickness: depth pinned, face-parallel * CoarserStride) ----
    // All offsets are {0, 0.5, 1.0} * even CoarserStride -> integer voxel coords. [loop]: one inlined
    // GetVoxelAt (F2.13).
    float Densities[13];
    [loop]
    for (uint i = 0; i < 13u; i++)
    {
        float3 Off = Tv_TransitionSampleOffset(Face, i);
        int SX = (DepthAxis == 0) ? BoundaryDepthCoord : (CellX + (int)round(Off.x * (float)CoarserStride));
        int SY = (DepthAxis == 1) ? BoundaryDepthCoord : (CellY + (int)round(Off.y * (float)CoarserStride));
        int SZ = (DepthAxis == 2) ? BoundaryDepthCoord : (CellZ + (int)round(Off.z * (float)CoarserStride));
        Densities[i] = GetDensityAt(int3(SX, SY, SZ));
    }
    // Lengyel invariant: coarse corners share the fine corners' state.
    Densities[9]  = Densities[0];
    Densities[10] = Densities[2];
    Densities[11] = Densities[6];
    Densities[12] = Densities[8];

    // ---- 9-bit case (Lengyel perimeter bit ordering) ----
    uint SolidMask = 0;
    [unroll]
    for (uint b = 0; b < 9u; b++)
    {
        if (Densities[BitToSample[b]] >= IsoLevel)
        {
            SolidMask |= (1u << b);
        }
    }
    uint CaseIndex = (~SolidMask) & 0x1FFu;

    uint CellClassData = Tv_TransitionCellClass(CaseIndex);
    bool bInverted = (CellClassData & 0x80u) != 0u;
    uint CellClass = CellClassData & 0x7Fu;
    if (CellClass == 0u || CellClass >= 56u)
    {
        return;
    }

    uint CellData = Tv_TransitionCellData(CellClass);
    uint VertexCount = CellData >> 4;
    uint TriangleCount = CellData & 0x0Fu;
    if (VertexCount == 0u || TriangleCount == 0u || VertexCount > 12u)
    {
        return;
    }

    // ---- Positions: zero-thickness ribbon collapsed onto the boundary plane ----
    float FaceScale = (float)CoarserStride * VoxelSize;
    float3 BasePos = ChunkWorldPosition + float3((float)CellX, (float)CellY, (float)CellZ) * VoxelSize;
    float3 CellScale = float3(FaceScale, FaceScale, FaceScale);
    if (DepthAxis == 0)      { BasePos.x = ChunkWorldPosition.x + (float)BoundaryDepthCoord * VoxelSize; CellScale.x = 0.0f; }
    else if (DepthAxis == 1) { BasePos.y = ChunkWorldPosition.y + (float)BoundaryDepthCoord * VoxelSize; CellScale.y = 0.0f; }
    else                     { BasePos.z = ChunkWorldPosition.z + (float)BoundaryDepthCoord * VoxelSize; CellScale.z = 0.0f; }

    // ---- Generate cell vertices ----
    float3 CellVertices[12];
    bool VertexOnOuterFace[12];
    uint VertexSamples[12];  // sample A | sample B << 4, for the vertex normals (G61)
    [unroll]
    for (uint i = 0; i < 12u; i++)
    {
        if (i >= VertexCount)
        {
            break;
        }
        uint VData = Tv_TransitionVertexData(CaseIndex, i);
        uint LowByte = VData & 0xFFu;
        uint EndpointA = (LowByte >> 4) & 0x0Fu;
        uint EndpointB = LowByte & 0x0Fu;
        uint SampleA = Tv_MapEndpointToSample(EndpointA);
        uint SampleB = Tv_MapEndpointToSample(EndpointB);

        float3 PosA = BasePos + Tv_TransitionSampleOffset(Face, SampleA) * CellScale;
        float3 PosB = BasePos + Tv_TransitionSampleOffset(Face, SampleB) * CellScale;

        float3 VertexPos;
        if (SampleA == SampleB)
        {
            VertexPos = PosA;
        }
        else
        {
            VertexPos = InterpolateEdge(Densities[SampleA], Densities[SampleB], PosA, PosB, IsoLevel);
        }
        CellVertices[i] = VertexPos;
        VertexSamples[i] = SampleA | (SampleB << 4);
        // Outer (coarse) face: both endpoints are coarse corners (samples 9-12)
        VertexOnOuterFace[i] = (SampleA >= 9u && SampleB >= 9u);
    }

    // The voxel crossing on each vertex's edge (G61's normal point at the adjacent mesh's stride; G80: the vertex itself on
    // a strided edge, as the coincident fine or coarse MC vertex has it), in one [loop] (F2.13).
    float3 CellCrossings[12];
    uint CrossingMask = 0u;
    [loop]
    for (uint ci = 0; ci < VertexCount; ci++)
    {
        int NS = VertexOnOuterFace[ci] ? CoarserStride : CurrentStride;
        uint SA = VertexSamples[ci] & 0x0Fu;
        uint SB = (VertexSamples[ci] >> 4) & 0x0Fu;
        float3 OffA = Tv_TransitionSampleOffset(Face, SA);
        float3 OffB = Tv_TransitionSampleOffset(Face, SB);
        int3 EA = int3(CellX, CellY, CellZ) + (int3)round(OffA * (float)CoarserStride);
        int3 EB = int3(CellX, CellY, CellZ) + (int3)round(OffB * (float)CoarserStride);
        if (DepthAxis == 0) { EA.x = BoundaryDepthCoord; EB.x = BoundaryDepthCoord; }
        else if (DepthAxis == 1) { EA.y = BoundaryDepthCoord; EB.y = BoundaryDepthCoord; }
        else { EA.z = BoundaryDepthCoord; EB.z = BoundaryDepthCoord; }
        int3 EdgeDelta = abs(EB - EA);
        int EdgeLength = EdgeDelta.x + EdgeDelta.y + EdgeDelta.z;
        float3 Crossing = float3(0.0f, 0.0f, 0.0f);
        if (SA != SB && (UseVoxelShadingNormals(NS) || UseVoxelLODCrossings(EdgeLength))
            && FindEdgeShadingPoint(EA, EB, Densities[SA], Densities[SB], Crossing))
        {
            CrossingMask |= (1u << ci);
            if (UseVoxelLODCrossings(EdgeLength))
            {
                CellVertices[ci] = ChunkWorldPosition + Crossing * VoxelSize;
            }
        }
        CellCrossings[ci] = Crossing;
    }

    // Geomorph the ribbon's FINE-side vertices toward the coarse surface, matching the (also
    // morphed) fine-MC boundary so they stay coincident -> the vertical wall collapses while the
    // seam stays watertight. OUTER (coarse-corner) vertices are left on the coarse contour so the
    // neighbour match is preserved. Done before triangle counting so count and emit agree.
    if (MCBoundaryMorph != 0u)
    {
        [loop]
        for (uint mi = 0; mi < VertexCount; mi++)
        {
            if (!VertexOnOuterFace[mi])
            {
                MorphVertexToCoarse(LODStride, (1u << Face), CellVertices[mi]);
            }
        }
    }

    // ---- Vertex normals at the stride of the adjacent mesh (outer face: the coarser neighbour's, else this chunk's).
    // G61: at a stride > 1, LOD 0's normal at the voxel crossing on the vertex's edge, as the coincident fine or coarse
    // MC vertex on that edge gets it; G62: at stride 1 the fitted gradient at the vertex, as the regular pass's; otherwise
    // the gradient at that stride, as before. ----
    float3 CellNormals[12];
    [loop]
    for (uint ni = 0; ni < VertexCount; ni++)
    {
        int NS = VertexOnOuterFace[ni] ? CoarserStride : CurrentStride;
        CellNormals[ni] = CalculateVertexNormal((CellVertices[ni] - ChunkWorldPosition) / VoxelSize, NS,
            (CrossingMask & (1u << ni)) != 0u, CellCrossings[ni]);
    }

    // ---- Material / biome from the first solid face sample (found first, then read once: F2.13) ----
    uint MaterialID = 0;
    uint BiomeID = 0;
    uint FirstSolid = 9u;
    [unroll]
    for (uint s = 0; s < 9u; s++)
    {
        if (FirstSolid == 9u && Densities[s] >= IsoLevel)
        {
            FirstSolid = s;
        }
    }
    if (FirstSolid < 9u)
    {
        float3 Off = Tv_TransitionSampleOffset(Face, FirstSolid);
        int SX = (DepthAxis == 0) ? BoundaryDepthCoord : (CellX + (int)round(Off.x * (float)CoarserStride));
        int SY = (DepthAxis == 1) ? BoundaryDepthCoord : (CellY + (int)round(Off.y * (float)CoarserStride));
        int SZ = (DepthAxis == 2) ? BoundaryDepthCoord : (CellZ + (int)round(Off.z * (float)CoarserStride));
        uint Packed = GetVoxelAt(int3(SX, SY, SZ));
        MaterialID = GetMaterialID(Packed);
        BiomeID = GetBiomeID(Packed);
    }

    // ---- Winding: reflection along depth flips handedness for +/-Y faces ----
    bool bFaceNeedsWindingReverse = (Face == 2u || Face == 3u);
    bool bUseOriginalWinding = (bInverted != bFaceNeedsWindingReverse);

    // ---- Degenerate (fin) triangle filter: drop tris with an over-long edge ----
    float MaxCellDim = max(max(CellScale.x, CellScale.y), CellScale.z);
    float MaxEdgeLengthSq = MaxCellDim * MaxCellDim * 4.0f;

    // Count valid triangles so soup allocation is exact (no buffer gaps).
    uint ValidTriCount = 0;
    [loop]
    for (uint t = 0; t < TriangleCount; t++)
    {
        uint i0 = Tv_TransitionTriangle(CellClass, t * 3 + 0);
        if (i0 == 0xFFu) { break; }
        uint i1 = Tv_TransitionTriangle(CellClass, t * 3 + 1);
        uint i2 = Tv_TransitionTriangle(CellClass, t * 3 + 2);
        if (i0 >= VertexCount || i1 >= VertexCount || i2 >= VertexCount) { continue; }
        float3 A = CellVertices[i0];
        float3 B = CellVertices[i1];
        float3 C = CellVertices[i2];
        if (dot(B - A, B - A) > MaxEdgeLengthSq ||
            dot(C - B, C - B) > MaxEdgeLengthSq ||
            dot(A - C, A - C) > MaxEdgeLengthSq) { continue; }
        ValidTriCount++;
    }
    if (ValidTriCount == 0u)
    {
        return;
    }

    uint VertexStart;
    uint IndexStart;
    InterlockedAdd(MeshCounters[0], ValidTriCount * 3, VertexStart);
    InterlockedAdd(MeshCounters[1], ValidTriCount * 3, IndexStart);

    // Overflow guard (mirrors the main pass): drop this ribbon cell if it would exceed either buffer.
    if (VertexStart + ValidTriCount * 3u > MaxVertexCount || IndexStart + ValidTriCount * 3u > MaxIndexCount)
    {
        return;
    }

    uint CurrentVertex = VertexStart;
    uint CurrentIndex = IndexStart;

    [loop]
    for (uint t = 0; t < TriangleCount; t++)
    {
        uint i0 = Tv_TransitionTriangle(CellClass, t * 3 + 0);
        if (i0 == 0xFFu) { break; }
        uint i1 = Tv_TransitionTriangle(CellClass, t * 3 + 1);
        uint i2 = Tv_TransitionTriangle(CellClass, t * 3 + 2);
        if (i0 >= VertexCount || i1 >= VertexCount || i2 >= VertexCount) { continue; }

        float3 A = CellVertices[i0];
        float3 B = CellVertices[i1];
        float3 C = CellVertices[i2];
        if (dot(B - A, B - A) > MaxEdgeLengthSq ||
            dot(C - B, C - B) > MaxEdgeLengthSq ||
            dot(A - C, A - C) > MaxEdgeLengthSq) { continue; }

        // Source cell-vertex index per emitted slot (so normal stride matches the side)
        uint S0 = bUseOriginalWinding ? i0 : i2;
        uint S1 = i1;
        uint S2 = bUseOriginalWinding ? i2 : i0;

        float3 P0 = CellVertices[S0];
        float3 P1 = CellVertices[S1];
        float3 P2 = CellVertices[S2];

        float3 N0 = CellNormals[S0];
        float3 N1 = CellNormals[S1];
        float3 N2 = CellNormals[S2];

        float2 UV0, UV1, UV2;
        ComputeTriangleUVs(P0, P1, P2, UV0, UV1, UV2);

        OutputVertices[CurrentVertex + 0] = CreateSmoothVertex(P0, N0, UV0, MaterialID, BiomeID);
        OutputVertices[CurrentVertex + 1] = CreateSmoothVertex(P1, N1, UV1, MaterialID, BiomeID);
        OutputVertices[CurrentVertex + 2] = CreateSmoothVertex(P2, N2, UV2, MaterialID, BiomeID);

        OutputIndices[CurrentIndex + 0] = CurrentVertex + 0;
        OutputIndices[CurrentIndex + 1] = CurrentVertex + 1;
        OutputIndices[CurrentIndex + 2] = CurrentVertex + 2;

        CurrentVertex += 3;
        CurrentIndex += 3;
    }
}

// ==================== Counter Reset Shader ====================

[numthreads(1, 1, 1)]
void ResetCountersCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    MeshCounters[0] = 0;  // Vertex counter
    MeshCounters[1] = 0;  // Index counter
    MeshCounters[2] = 0;  // Reserved
}
